<Page x:Class="MRMS.UI.Views.SalesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="المبيعات" FlowDirection="RightToLeft"
      Style="{StaticResource PageBackground}">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="المبيعات" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="عرض وتسجيل عمليات بيع الأصناف" Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}">
                    <Run Text="إجمالي المبيعات:"/>
                    <Run Text="{Binding Sales.Count, Mode=OneWay, FallbackValue=0}" FontWeight="SemiBold"
                         Foreground="{StaticResource TextPrimaryBrush}"/>
                </TextBlock>

                <Button Grid.Column="1" Content="+ عملية بيع جديدة"
                        Style="{StaticResource PrimaryButton}"
                        Click="AddSale_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0" Effect="{StaticResource CardShadow}">
            <Grid>
                <DataGrid ItemsSource="{Binding Sales}"
                          Style="{StaticResource ModernDataGrid}"
                          AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat={}{0:yyyy-MM-dd}}" Width="90"/>
                        <DataGridTextColumn Header="الصنف" Binding="{Binding ItemName}" Width="*"/>
                        <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity}" Width="70"/>
                        <DataGridTextColumn Header="سعر الوحدة" Binding="{Binding UnitPrice, StringFormat={}{0:N0}}" Width="90"/>
                        <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalPrice, StringFormat={}{0:N0}}" Width="90"/>
                        <DataGridTextColumn x:Name="ProfitColumn" Header="الربح" Binding="{Binding Profit, StringFormat={}{0:N0}}" Width="80"/>
                        <DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="100"/>
                        <DataGridTemplateColumn Header="الإجراءات" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="حذف"
                                            Style="{StaticResource DangerActionButton}"
                                            Command="{Binding DataContext.DeleteSaleCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding Id}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <ProgressBar IsIndeterminate="True"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                             Height="3" VerticalAlignment="Top"
                             Style="{StaticResource ModernProgressBar}"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,12" VerticalAlignment="Bottom">
                    <Button Content="السابق" Style="{StaticResource SecondaryButton}"
                            Command="{Binding PreviousPageCommand}"
                            IsEnabled="{Binding HasPrevious}"
                            Padding="12,6"/>
                    <TextBlock Text="{Binding PageInfo}" VerticalAlignment="Center" Margin="16,0"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                    <Button Content="التالي" Style="{StaticResource SecondaryButton}"
                            Command="{Binding NextPageCommand}"
                            IsEnabled="{Binding HasNext}"
                            Padding="12,6"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
