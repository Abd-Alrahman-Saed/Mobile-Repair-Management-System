<Window x:Class="MRMS.UI.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تغيير كلمة المرور"
        Icon="/Resources/AppIcon.ico"
        Height="360" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="يجب تعيين كلمة مرور جديدة"
                   FontSize="18" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="كلمة المرور الحالية" Margin="0,0,0,5"/>
            <PasswordBox x:Name="CurrentBox" Height="30" FontSize="14" Padding="5,0"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="كلمة المرور الجديدة" Margin="0,0,0,5"/>
            <PasswordBox x:Name="NewBox" Height="30" FontSize="14" Padding="5,0"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <TextBlock Text="تأكيد كلمة المرور الجديدة" Margin="0,0,0,5"/>
            <PasswordBox x:Name="ConfirmBox" Height="30" FontSize="14" Padding="5,0"
                         KeyDown="ConfirmBox_KeyDown"/>
        </StackPanel>

        <TextBlock Grid.Row="4" Text="{Binding ErrorMessage}"
                   Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center"
                   TextWrapping="Wrap" Margin="0,0,0,10"/>

        <Button Grid.Row="5" Content="حفظ"
                Click="Save_Click"
                Height="35" FontSize="14"
                Background="{StaticResource PrimaryBrush}" Foreground="White"
                Cursor="Hand"/>
    </Grid>
</Window>
