<Window x:Class="MRMS.UI.Views.PurchaseDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تفاصيل فاتورة المشتريات" Height="620" Width="560"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="تفاصيل فاتورة المشتريات" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="عرض بيانات الفاتورة كما تم إدخالها" Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                    <TextBlock Text="التاريخ" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="DateText" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                    <TextBlock Text="المورد" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="SupplierText" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                    <TextBlock Text="طريقة الدفع" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="PaymentMethodText" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
                    <TextBlock Text="المبلغ المدفوع" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="PaidAmountText" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                    <TextBlock Text="ملاحظات" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="NotesText" FontSize="14" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0" Effect="{StaticResource CardShadow}" Margin="0,0,0,16">
            <DataGrid x:Name="ItemsGrid"
                      Style="{StaticResource ModernDataGrid}"
                      AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الصنف" Binding="{Binding ItemName}" Width="*"/>
                    <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity}" Width="80"/>
                    <DataGridTextColumn Header="سعر الوحدة" Binding="{Binding UnitCost, StringFormat={}{0:N0}}" Width="100"/>
                    <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalCost, StringFormat={}{0:N0}}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="3" HorizontalAlignment="Left" Margin="0,0,0,16"
                   FontSize="16" FontWeight="SemiBold"
                   Foreground="{StaticResource PrimaryBrush}">
            <Run Text="الإجمالي الكلي:"/>
            <Run x:Name="TotalCostRun" FontWeight="Bold"/>
        </TextBlock>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="إغلاق" Style="{StaticResource SecondaryButton}" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
