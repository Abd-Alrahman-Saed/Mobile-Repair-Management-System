<Page x:Class="MRMS.UI.Views.TrialBalancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="ميزان المراجعة" FlowDirection="RightToLeft"
      Style="{StaticResource PageBackground}">

    <ScrollViewer>
        <StackPanel Margin="28">

            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="ميزان المراجعة" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="ملخص أركان الحسابات - مجموع الديون = مجموع الدائون" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>

            <Border Style="{StaticResource CardBorder}" Padding="20" Margin="0,0,0,20"
                    Effect="{StaticResource CardShadow}">
                <WrapPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="حتى تاريخ:" Style="{StaticResource FormLabel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker SelectedDate="{Binding AsOfDate}" Style="{StaticResource FormTextBox}" Width="140"/>
                    </StackPanel>
                    <Button Content="عرض" Command="{Binding LoadCommand}"
                            Style="{StaticResource PrimaryButton}" Padding="24,10"/>
                </WrapPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Padding="0" Margin="0,0,0,20"
                    Effect="{StaticResource CardShadow}">
                <DataGrid ItemsSource="{Binding TrialBalance.Rows}" Style="{StaticResource ModernDataGrid}"
                          AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الحساب" Binding="{Binding AccountName}" Width="300"/>
                        <DataGridTextColumn Header="إجمالي المدين" Binding="{Binding TotalDebits, StringFormat={}{0:N0}}" Width="150"/>
                        <DataGridTextColumn Header="إجمالي الدائن" Binding="{Binding TotalCredits, StringFormat={}{0:N0}}" Width="150"/>
                        <DataGridTextColumn Header="الرصيد" Binding="{Binding Balance, StringFormat={}{0:N0}}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Style="{StaticResource CardBorder}" Padding="20" Margin="0,0,0,20"
                    Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="الإجمالي" FontSize="15" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1" Text="{Binding TrialBalance.GrandTotalDebits, StringFormat={}{0:N0}}"
                                   FontSize="15" FontWeight="Bold" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="2" Text="{Binding TrialBalance.GrandTotalCredits, StringFormat={}{0:N0}}"
                                   FontSize="15" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </Grid>

                    <Border CornerRadius="8" Padding="12,8"
                            Background="{StaticResource SuccessLightBrush}" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="الحالة: " FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TrialBalance.IsBalanced, Converter={StaticResource Not}}"
                                       FontSize="14" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"
                                       Visibility="{Binding TrialBalance.IsBalanced, Converter={StaticResource InverseBoolToVis}}"/>
                            <TextBlock Text="متوازن ✓" FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource SuccessBrush}"
                                       Visibility="{Binding TrialBalance.IsBalanced, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <ProgressBar IsIndeterminate="True"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                         Style="{StaticResource ModernProgressBar}"/>
        </StackPanel>
    </ScrollViewer>
</Page>
