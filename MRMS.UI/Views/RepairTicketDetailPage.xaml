<Page x:Class="MRMS.UI.Views.RepairTicketDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="تفاصيل تذكرة الصيانة" FlowDirection="RightToLeft"
      Style="{StaticResource PageBackground}">
    <ScrollViewer FlowDirection="LeftToRight">
        <StackPanel Margin="28" FlowDirection="RightToLeft">
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="تفاصيل تذكرة الصيانة" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{Binding SelectedTicket.TicketNumber, StringFormat='تذكرة رقم: {0}'}"
                           Style="{StaticResource PageSubtitle}"/>
            </StackPanel>

            <!-- Ticket Info Card -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="العميل" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,16,8"/>
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding SelectedTicket.CustomerName}" FontSize="14"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="الجهاز" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,16,8"/>
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{Binding SelectedTicket.DeviceInfo}" FontSize="14"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="المشكلة" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,16,8"/>
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   Text="{Binding SelectedTicket.ProblemDescription}" FontSize="14"
                                   Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="الحالة" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,16,8"/>
                        <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource StatusTag}"
                                HorizontalAlignment="Right" Margin="0,0,0,8"
                                Background="{Binding SelectedTicket.Status, Converter={StaticResource TicketStatusBrush}, ConverterParameter=Background}">
                            <TextBlock Text="{Binding SelectedTicket.Status, Converter={StaticResource TicketStatus}}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{Binding SelectedTicket.Status, Converter={StaticResource TicketStatusBrush}, ConverterParameter=Text}"/>
                        </Border>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="تاريخ الاستقبال" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,16,0"/>
                        <TextBlock Grid.Row="4" Grid.Column="1"
                                   Text="{Binding SelectedTicket.ReceiveDate, StringFormat={}{0:yyyy-MM-dd}}" FontSize="14"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Timeline -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16"
                    Visibility="{Binding IsCancelled, Converter={StaticResource InverseBoolToVis}}">
                <ItemsControl ItemsSource="{Binding TimelineSteps}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel HorizontalAlignment="Center">
                                <Ellipse Width="14" Height="14" HorizontalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource BorderBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPast}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource PrimaryBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding Label}" FontSize="11" HorizontalAlignment="Center"
                                           Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16"
                    Background="{StaticResource DangerLightBrush}"
                    Visibility="{Binding IsCancelled, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="تم إلغاء هذه التذكرة" FontWeight="Bold"
                           Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center"/>
            </Border>

            <!-- Status Update -->
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="5" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="تحديث الحالة" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox ItemsSource="{Binding AllowedNextStatuses}"
                                  SelectedItem="{Binding SelectedStatus}"
                                  Width="200" Height="30" FontSize="14">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource TicketStatus}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Content="تحديث" Command="{Binding UpdateStatusCommand}"
                                Margin="10,0,0,0" Padding="15,5"
                                Background="{StaticResource PrimaryBrush}" Foreground="White"/>
                        <Button Command="{Binding NotifyCustomerCommand}"
                                Margin="10,0,0,0" Padding="15,5"
                                Visibility="{Binding CanNotifyCustomer, Converter={StaticResource BoolToVis}}"
                                Background="{StaticResource SuccessBrush}" Foreground="White">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Content" Value="إبلاغ العميل"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNotified}" Value="True">
                                            <Setter Property="Content" Value="تم الإبلاغ ✓"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Technician -->
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="5" Padding="15" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="الفني المسؤول" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                    <ComboBox Width="220" Height="30" FontSize="14"
                              ItemsSource="{Binding AvailableTechnicians}"
                              DisplayMemberPath="FullName" SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedTechnicianId}"/>
                    <Button Content="إلغاء التخصيص" Command="{Binding UnassignTechnicianCommand}"
                            Margin="8,0,0,0" Padding="10,5"/>
                </StackPanel>
            </Border>

            <!-- Repair Info -->
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="5" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="بيانات الصيانة" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="وصف الصيانة" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding RepairDescription}" Height="60" Width="400"
                             HorizontalAlignment="Right" FontSize="14"
                             AcceptsReturn="True" TextWrapping="Wrap"/>
                    <TextBlock Text="المبلغ الإجمالي المستحق من العميل (شامل قطع الغيار وأجرة المصنعية)" Margin="0,10,0,5"/>
                    <TextBox Text="{Binding Cost, UpdateSourceTrigger=PropertyChanged}" Height="30" Width="150"
                             HorizontalAlignment="Right" FontSize="14"/>
                    <TextBlock Margin="0,8,0,0" FontSize="13">
                        <Run Text="تكلفة قطع الغيار المستخدمة:" Foreground="Gray"/>
                        <Run Text="{Binding PartsTotalCost, Mode=OneWay, StringFormat={}{0:N0}}" FontWeight="SemiBold"/>
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0" FontSize="13">
                        <Run Text="الربح المتوقع من هذه التذكرة:" Foreground="Gray"/>
                        <Run Text="{Binding ExpectedProfit, Mode=OneWay, StringFormat={}{0:N0}}" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                    </TextBlock>
                    <Button Content="حفظ" Command="{Binding UpdateRepairInfoCommand}"
                            Margin="0,10,0,0" Padding="15,5"
                            Background="{StaticResource SuccessBrush}" Foreground="White"/>
                </StackPanel>
            </Border>

            <!-- Payment -->
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="5" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="الدفع" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="التكلفة الإجمالية" FontSize="12" Foreground="Gray"/>
                            <TextBlock Text="{Binding Cost, StringFormat={}{0:N0}}" FontSize="16" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="المدفوع" FontSize="12" Foreground="Gray"/>
                            <TextBlock Text="{Binding PaidAmount, StringFormat={}{0:N0}}" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource SuccessBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="المتبقي" FontSize="12" Foreground="Gray"/>
                            <TextBlock Text="{Binding RemainingAmount, StringFormat={}{0:N0}}" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource DangerBrush}"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBox Text="{Binding CollectPaymentAmount, UpdateSourceTrigger=PropertyChanged}"
                                 Height="30" Width="150" FontSize="14"/>
                        <Button Content="تسجيل دفعة" Command="{Binding CollectPaymentCommand}"
                                Margin="10,0,0,0" Padding="15,5"
                                Background="{StaticResource PrimaryBrush}" Foreground="White"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Parts -->
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="5" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="قطع الغيار والإكسسوارات" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableItems}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedPartItemId}"
                                  Height="30" FontSize="14"/>
                        <TextBox Grid.Column="1" Text="{Binding PartQuantity, UpdateSourceTrigger=PropertyChanged}"
                                 Height="30" FontSize="14" Margin="8,0,0,0"/>
                        <TextBox Grid.Column="2" Text="{Binding PartUnitCost, UpdateSourceTrigger=PropertyChanged}"
                                 Height="30" FontSize="14" Margin="8,0,0,0"/>
                        <Button Grid.Column="3" Content="إضافة قطعة"
                                Command="{Binding AddPartCommand}"
                                Margin="8,0,0,0" Padding="10,5"
                                Background="{StaticResource PrimaryBrush}" Foreground="White"/>
                        <Button Grid.Column="4" Content="+ صنف جديد"
                                Click="AddNewPart_Click"
                                Margin="8,0,0,0" Padding="10,5"
                                Background="{StaticResource TextSecondaryBrush}" Foreground="White"/>
                    </Grid>

                    <DataGrid ItemsSource="{Binding Parts}"
                              AutoGenerateColumns="False" Height="150"
                              Margin="0,0,0,8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="القطعة" Binding="{Binding ItemName}" Width="*"/>
                            <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity}" Width="70"/>
                            <DataGridTextColumn Header="سعر الوحدة" Binding="{Binding UnitCost, StringFormat={}{0:N0}}" Width="90"/>
                            <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalCost, StringFormat={}{0:N0}}" Width="90"/>
                            <DataGridTemplateColumn Header="حذف" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="×"
                                                Command="{Binding DataContext.RemovePartCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                Padding="5,2" Foreground="Red"
                                                Background="Transparent" BorderThickness="0"
                                                Cursor="Hand"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock HorizontalAlignment="Left" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBrush}">
                        <Run Text="إجمالي تكلفة القطع:"/>
                        <Run Text="{Binding PartsTotalCost, StringFormat={}{0:N0}}" FontWeight="Bold"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Photos -->
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="5" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="الصور" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="إضافة صورة قبل" Click="AddPhotoBefore"
                                Padding="10,5" Margin="0,0,10,0"/>
                        <Button Content="إضافة صورة بعد" Click="AddPhotoAfter"
                                Padding="10,5"/>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Photos}" Margin="0,10,0,0" Height="200"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5"
                                        Margin="5" Padding="3" Cursor="Hand">
                                    <StackPanel>
                                        <Image Source="{Binding FilePath}" Width="150" Height="150"
                                               Stretch="UniformToFill"
                                               MouseLeftButtonUp="Image_MouseLeftButtonUp"/>
                                        <TextBlock Text="{Binding PhotoType}"
                                                   HorizontalAlignment="Center" FontSize="11" Foreground="Gray"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- Warranty -->
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="5" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="الضمان" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="مدة الضمان (أيام)" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Text="{Binding WarrantyDuration}" Height="30" Width="150"
                                 HorizontalAlignment="Right" FontSize="14"/>
                        <Button Content="تعيين الضمان" Click="AssignWarranty"
                                Margin="10,0,0,0" Padding="10,5"
                                Background="{StaticResource WarningBrush}" Foreground="White"/>
                    </StackPanel>
                    <TextBlock Text="{Binding WarrantyInfo}" Margin="0,5,0,0" Foreground="Gray"/>
                </StackPanel>
            </Border>

            <!-- Error -->
            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red"
                       HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <!-- Print Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="طباعة الفاتورة" Click="PrintInvoice"
                        Padding="15,8" Background="{StaticResource TextPrimaryBrush}" Foreground="White"
                        Cursor="Hand" Margin="0,0,8,0"/>
                <Button Content="وصل استلام" Click="PrintReceptionReceipt"
                        Padding="15,8" Background="{StaticResource PrimaryBrush}" Foreground="White"
                        Cursor="Hand"/>
            </StackPanel>

            <ProgressBar IsIndeterminate="True"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                         Height="5" Margin="0,15,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Page>
