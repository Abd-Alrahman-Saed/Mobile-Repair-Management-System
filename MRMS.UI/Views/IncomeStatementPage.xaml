<Page x:Class="MRMS.UI.Views.IncomeStatementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="قائمة الدخل" FlowDirection="RightToLeft"
      Style="{StaticResource PageBackground}">

    <ScrollViewer>
        <StackPanel Margin="28">

            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="قائمة الدخل" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="بيان الأرباح والخسائر" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>

            <Border Style="{StaticResource CardBorder}" Padding="20" Margin="0,0,0,20"
                    Effect="{StaticResource CardShadow}">
                <WrapPanel Margin="0,0,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center">
                        <TextBlock Text="من:" Style="{StaticResource FormLabel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker SelectedDate="{Binding From}" Style="{StaticResource FormTextBox}" Width="140"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center">
                        <TextBlock Text="إلى:" Style="{StaticResource FormLabel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker SelectedDate="{Binding To}" Style="{StaticResource FormTextBox}" Width="140"/>
                    </StackPanel>
                    <Button Content="عرض" Command="{Binding LoadCommand}"
                            Style="{StaticResource PrimaryButton}" Padding="20,10" Margin="0,0,10,0"/>
                    <Button Content="هذا الشهر" Command="{Binding ThisMonthCommand}"
                            Style="{StaticResource SecondaryButton}" Padding="16,10" Margin="0,0,6,0"/>
                    <Button Content="الشهر الماضي" Command="{Binding LastMonthCommand}"
                            Style="{StaticResource SecondaryButton}" Padding="16,10" Margin="0,0,6,0"/>
                    <Button Content="هذه السنة" Command="{Binding ThisYearCommand}"
                            Style="{StaticResource SecondaryButton}" Padding="16,10"/>
                </WrapPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Padding="28" Margin="0,0,0,20"
                    Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <TextBlock Text="ملخص الأرباح والخسائر" Style="{StaticResource SectionTitle}" Margin="0,0,0,20"/>

                    <!-- Revenue Section -->
                    <TextBlock Text="الإيرادات" FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="إيرادات المبيعات" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Statement.SalesRevenue, StringFormat={}{0:N0}}"
                                   FontSize="15" FontWeight="Medium" HorizontalAlignment="Right"/>
                    </Grid>
                    <Rectangle Style="{StaticResource Divider}" Margin="0,4"/>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="إيرادات الصيانة" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Statement.RepairRevenue, StringFormat={}{0:N0}}"
                                   FontSize="15" FontWeight="Medium" HorizontalAlignment="Right"/>
                    </Grid>
                    <Rectangle Style="{StaticResource Divider}" Margin="0,4"/>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="إجمالي الإيرادات" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Statement.TotalRevenue, StringFormat={}{0:N0}}"
                                   FontSize="16" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <Rectangle Style="{StaticResource Divider}" Margin="0,4,0,16"/>

                    <!-- COGS Section -->
                    <TextBlock Text="تكلفة المبيعات" FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource WarningBrush}" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="تكلفة البضاعة المباعة" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Statement.CostOfGoodsSold, StringFormat={}{0:N0}}"
                                   FontSize="15" FontWeight="Medium" HorizontalAlignment="Right"/>
                    </Grid>
                    <Rectangle Style="{StaticResource Divider}" Margin="0,4"/>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="تكلفة قطع الصيانة" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Statement.RepairPartsCost, StringFormat={}{0:N0}}"
                                   FontSize="15" FontWeight="Medium" HorizontalAlignment="Right"/>
                    </Grid>
                    <Rectangle Style="{StaticResource Divider}" Margin="0,4"/>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="إجمالي التكاليف" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Path=Statement.CostOfGoodsSold, StringFormat={}{0:N0}, Converter={StaticResource InverseSign}}"
                                   FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Gross Profit -->
                    <Border Background="{StaticResource SuccessLightBrush}" CornerRadius="10" Padding="16,12" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="إجمالي الربح" FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource SuccessBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Statement.GrossProfit, StringFormat={}{0:N0}}"
                                       FontSize="18" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <Rectangle Style="{StaticResource Divider}" Margin="0,4,0,16"/>

                    <!-- Expenses Section -->
                    <TextBlock Text="المصروفات" FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource DangerBrush}" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="المصروفات التشغيلية" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Statement.OperatingExpenses, StringFormat={}{0:N0}}"
                                   FontSize="15" FontWeight="Medium" HorizontalAlignment="Right"/>
                    </Grid>
                    <Rectangle Style="{StaticResource Divider}" Margin="0,4"/>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="خسائر التوالف" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Statement.DamageLosses, StringFormat={}{0:N0}}"
                                   FontSize="15" FontWeight="Medium" HorizontalAlignment="Right"/>
                    </Grid>
                    <Rectangle Style="{StaticResource Divider}" Margin="0,4"/>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="إجمالي المصروفات" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Path=Statement.OperatingExpenses, StringFormat={}{0:N0}, Converter={StaticResource InverseSign}}"
                                   FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Net Profit -->
                    <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="12" Padding="20,16" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="صافي الربح / الخسارة" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock Text="الفترة من {Binding Statement.From, StringFormat={}{0:yyyy-MM-dd}} إلى {Binding Statement.To, StringFormat={}{0:yyyy-MM-dd}}"
                                           FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Statement.NetProfit, StringFormat={}{0:N0}}"
                                       FontSize="22" FontWeight="Bold"
                                       HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Statement.NetProfit}" Value="0">
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Statement.NetProfit, Converter={StaticResource LessThanZero}}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <ProgressBar IsIndeterminate="True"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                         Style="{StaticResource ModernProgressBar}"/>
        </StackPanel>
    </ScrollViewer>
</Page>
