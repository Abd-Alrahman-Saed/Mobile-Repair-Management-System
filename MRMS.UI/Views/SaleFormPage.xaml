<Page x:Class="MRMS.UI.Views.SaleFormPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="فاتورة مبيعات" FlowDirection="RightToLeft"
      Style="{StaticResource PageBackground}">

    <ScrollViewer>
        <StackPanel Margin="28">
            <StackPanel Margin="0,0,0,28">
                <TextBlock Text="فاتورة مبيعات جديدة" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="أضف صنف أو أكتر للفاتورة ثم احفظ واطبع" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>

            <!-- Add line -->
            <Border Style="{StaticResource CardBorder}" Padding="20" Width="650" HorizontalAlignment="Center" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="مسح باركود الصنف (QR / Barcode) - يضاف للفاتورة فوراً" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="ScanBox" Text="{Binding ScanCode, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBox}" KeyDown="ScanBox_KeyDown"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="الصنف" Style="{StaticResource FormLabel}"/>
                            <ComboBox ItemsSource="{Binding Items}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedItemId, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource FormTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="الكمية" Style="{StaticResource FormLabel}"/>
                            <TextBox x:Name="QuantityBox" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="سعر الوحدة" Style="{StaticResource FormLabel}"/>
                            <TextBox Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Margin="0,0,0,12" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                        <Run Text="الكمية المتوفرة حالياً:"/>
                        <Run Text="{Binding SelectedItemCurrentStock, Mode=OneWay}" FontWeight="SemiBold"
                             Foreground="{StaticResource TextPrimaryBrush}"/>
                    </TextBlock>

                    <Button Content="+ إضافة سطر" Style="{StaticResource SecondaryButton}"
                            Command="{Binding AddLineCommand}" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- Lines table -->
            <Border Style="{StaticResource CardBorder}" Padding="0" Width="650" HorizontalAlignment="Center" Margin="0,0,0,16"
                    Effect="{StaticResource CardShadow}">
                <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False" IsReadOnly="True"
                          Style="{StaticResource ModernDataGrid}" MaxHeight="220">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الصنف" Binding="{Binding ItemName}" Width="*"/>
                        <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity}" Width="70"/>
                        <DataGridTextColumn Header="السعر" Binding="{Binding UnitPrice, StringFormat={}{0:N0}}" Width="80"/>
                        <DataGridTextColumn Header="الإجمالي" Binding="{Binding LineTotal, StringFormat={}{0:N0}}" Width="90"/>
                        <DataGridTemplateColumn Header="حذف" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="×" Foreground="Red" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Invoice-level fields -->
            <Border Style="{StaticResource CardBorder}" Padding="20" Width="650" HorizontalAlignment="Center" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="طريقة الدفع" Style="{StaticResource FormLabel}"/>
                            <ComboBox SelectedValuePath="Tag"
                                      SelectedValue="{Binding PaymentMethod, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource FormTextBox}">
                                <ComboBoxItem Content="نقدي" Tag="Cash"/>
                                <ComboBoxItem Content="آجل" Tag="Credit"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="العميل (اختياري - إجباري للبيع الآجل)" Style="{StaticResource FormLabel}"/>
                            <ComboBox ItemsSource="{Binding Customers}"
                                      DisplayMemberPath="FullName"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedCustomerId, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource FormTextBox}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="اسم العميل (لبيع سريع بلا تسجيل)" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBox}"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="الخصم" Style="{StaticResource FormLabel}"/>
                            <TextBox Text="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="المبلغ المدفوع الآن" Style="{StaticResource FormLabel}"/>
                            <TextBox Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"/>
                        </StackPanel>
                    </Grid>

                    <Border Background="{StaticResource PrimaryLightBrush}"
                            CornerRadius="8" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Foreground="{StaticResource PrimaryBrush}" FontSize="14">
                                <Run Text="الإجمالي الفرعي:"/>
                                <Run Text="{Binding Subtotal, StringFormat={}{0:N0}}" FontWeight="SemiBold"/>
                            </TextBlock>
                            <TextBlock Foreground="{StaticResource PrimaryBrush}" FontSize="16" Margin="0,8,0,0">
                                <Run Text="الإجمالي:"/>
                                <Run Text="{Binding Total, StringFormat={}{0:N0}}" FontWeight="Bold"/>
                            </TextBlock>
                            <TextBlock Foreground="{StaticResource DangerBrush}" FontSize="14" Margin="0,8,0,0">
                                <Run Text="المتبقي:"/>
                                <Run Text="{Binding Remaining, StringFormat={}{0:N0}}" FontWeight="Bold"/>
                            </TextBlock>
                            <TextBlock Foreground="{StaticResource SuccessBrush}" FontSize="16" Margin="0,8,0,0"
                                       Visibility="{Binding CanViewProfit, Converter={StaticResource BoolToVis}}">
                                <Run Text="الربح المتوقع:"/>
                                <Run Text="{Binding Profit, StringFormat={}{0:N0}}" FontWeight="Bold"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="0,0,0,4">
                        <TextBlock Text="ملاحظات" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBox}" Height="60" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Background="{StaticResource DangerLightBrush}"
                            CornerRadius="8" Padding="12,10"
                            Margin="0,16,0,4"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource NonEmptyStringToVis}}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{StaticResource DangerBrush}" FontSize="13"
                                   FontWeight="Medium"/>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderNoShadow}"
                    Background="{StaticResource DividerBrush}"
                    BorderThickness="0" Padding="16" Width="650" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="حفظ وطباعة الفاتورة" Style="{StaticResource PrimaryButton}"
                            Command="{Binding SaveCommand}" Margin="0,0,12,0"/>
                    <Button Content="إلغاء" Style="{StaticResource SecondaryButton}"
                            Command="{Binding CancelCommand}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
