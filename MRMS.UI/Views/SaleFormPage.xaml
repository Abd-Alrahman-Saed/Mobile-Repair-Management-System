<Page x:Class="MRMS.UI.Views.SaleFormPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="تسجيل بيع" FlowDirection="RightToLeft"
      Style="{StaticResource PageBackground}">

    <ScrollViewer>
        <StackPanel Margin="28">
            <StackPanel Margin="0,0,0,28">
                <TextBlock Text="تسجيل عملية بيع" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="تسجيل بيع صنف للعميل مع حساب الربح" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>

            <Border Style="{StaticResource CardBorder}" Padding="20" Width="550" HorizontalAlignment="Center" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="مسح باركود الصنف (QR / Barcode)" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="ScanBox" Text="{Binding ScanCode, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBox}" KeyDown="ScanBox_KeyDown"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="التاريخ" Style="{StaticResource FormLabel}"/>
                        <DatePicker SelectedDate="{Binding Date, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource FormTextBox}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="الصنف" Style="{StaticResource FormLabel}"/>
                        <ComboBox ItemsSource="{Binding Items}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedItemId, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource FormTextBox}"/>
                        <TextBlock Margin="0,6,0,0" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}">
                            <Run Text="الكمية المتوفرة حالياً:"/>
                            <Run Text="{Binding SelectedItemCurrentStock, Mode=OneWay}" FontWeight="SemiBold"
                                 Foreground="{StaticResource TextPrimaryBrush}"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="الكمية" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="QuantityBox" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBox}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="سعر الوحدة" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBox}"/>
                    </StackPanel>

                    <Border Background="{StaticResource PrimaryLightBrush}"
                            CornerRadius="8" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Foreground="{StaticResource PrimaryBrush}" FontSize="14"
                                       Visibility="{Binding CanViewProfit, Converter={StaticResource BoolToVis}}">
                                <Run Text="تكلفة الشراء:"/>
                                <Run Text="{Binding CostPrice, StringFormat={}{0:N0}}" FontWeight="SemiBold"/>
                            </TextBlock>
                            <TextBlock Foreground="{StaticResource PrimaryBrush}" FontSize="16" Margin="0,8,0,0">
                                <Run Text="الإجمالي:"/>
                                <Run Text="{Binding TotalPrice, StringFormat={}{0:N0}}" FontWeight="Bold"/>
                            </TextBlock>
                            <TextBlock Foreground="{StaticResource SuccessBrush}" FontSize="16" Margin="0,8,0,0"
                                       Visibility="{Binding CanViewProfit, Converter={StaticResource BoolToVis}}">
                                <Run Text="الربح المتوقع:"/>
                                <Run Text="{Binding Profit, StringFormat={}{0:N0}}" FontWeight="Bold"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="اسم العميل (اختياري)" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBox}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,4">
                        <TextBlock Text="ملاحظات" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBox}" Height="60" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Background="{StaticResource DangerLightBrush}"
                            CornerRadius="8" Padding="12,10"
                            Margin="0,16,0,4"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource InverseBoolToVis}, FallbackValue=Collapsed}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{StaticResource DangerBrush}" FontSize="13"
                                   FontWeight="Medium"/>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderNoShadow}"
                    Background="{StaticResource DividerBrush}"
                    BorderThickness="0" Padding="16" Width="550" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="تسجيل البيع" Style="{StaticResource PrimaryButton}"
                            Command="{Binding SaveCommand}" Margin="0,0,12,0"/>
                    <Button Content="إلغاء" Style="{StaticResource SecondaryButton}"
                            Command="{Binding CancelCommand}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
