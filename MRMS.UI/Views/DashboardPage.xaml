<Page x:Class="MRMS.UI.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="لوحة التحكم" FlowDirection="RightToLeft"
      Style="{StaticResource PageBackground}">

    <Page.Resources>
        <Style x:Key="KpiCard" TargetType="Border" BasedOn="{StaticResource CardBorder}">
            <Setter Property="Width" Value="195"/>
            <Setter Property="Height" Value="132"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,16,16"/>
        </Style>
        <Style x:Key="KpiKicker" TargetType="TextBlock" BasedOn="{StaticResource MutedLabel}"/>
        <Style x:Key="KpiNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style x:Key="KpiIcon" TargetType="Border">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,10,0,8"/>
        </Style>
    </Page.Resources>

    <ScrollViewer FlowDirection="LeftToRight">
        <StackPanel Margin="28" FlowDirection="RightToLeft">

            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="لوحة التحكم" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="نظرة عامة على أداء مركز الصيانة" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>

            <!-- ===== Operational KPIs (all roles) ===== -->
            <WrapPanel Margin="0,0,0,8">
                <Border Style="{StaticResource KpiCard}">
                    <StackPanel>
                        <TextBlock Text="مستلم اليوم" Style="{StaticResource KpiKicker}"/>
                        <Border Style="{StaticResource KpiIcon}" Background="{StaticResource PrimaryLightBrush}">
                            <TextBlock Text="📥" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding Stats.TodayReceived}" Style="{StaticResource KpiNumber}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCard}">
                    <StackPanel>
                        <TextBlock Text="تم التسليم اليوم" Style="{StaticResource KpiKicker}"/>
                        <Border Style="{StaticResource KpiIcon}" Background="{StaticResource SuccessLightBrush}">
                            <TextBlock Text="✅" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding Stats.TodayDelivered}" Style="{StaticResource KpiNumber}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCard}">
                    <StackPanel>
                        <TextBlock Text="قيد الإصلاح" Style="{StaticResource KpiKicker}"/>
                        <Border Style="{StaticResource KpiIcon}" Background="{StaticResource InfoLightBrush}">
                            <TextBlock Text="🔧" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding Stats.CurrentlyInRepair}" Style="{StaticResource KpiNumber}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCard}">
                    <StackPanel>
                        <TextBlock Text="بانتظار القطع" Style="{StaticResource KpiKicker}"/>
                        <Border Style="{StaticResource KpiIcon}" Background="{StaticResource WarningLightBrush}">
                            <TextBlock Text="⏳" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding Stats.WaitingForParts}" Style="{StaticResource KpiNumber}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCard}">
                    <StackPanel>
                        <TextBlock Text="مخزون منخفض" Style="{StaticResource KpiKicker}"/>
                        <Border Style="{StaticResource KpiIcon}" Background="{StaticResource DangerLightBrush}">
                            <TextBlock Text="📦" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding Stats.LowStockCount}" Style="{StaticResource KpiNumber}"
                                   Foreground="{StaticResource DangerBrush}"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- ===== Financial KPIs (owner / manager only) ===== -->
            <StackPanel Visibility="{Binding CanViewFinancials, Converter={StaticResource BoolToVis}}"
                        Margin="0,12,0,0">
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="المؤشرات المالية" Style="{StaticResource SectionTitle}" Margin="0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PeriodLabel}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Content="هذا الشهر" Command="{Binding ThisMonthCommand}"
                                Style="{StaticResource GhostButton}" Padding="12,5" FontSize="12"/>
                        <Button Content="الشهر الماضي" Command="{Binding LastMonthCommand}"
                                Style="{StaticResource GhostButton}" Padding="12,5" FontSize="12"/>
                    </StackPanel>
                </Grid>

                <WrapPanel Margin="0,0,0,8">
                    <Border Style="{StaticResource KpiCard}" Width="235">
                        <StackPanel>
                            <TextBlock Text="صافي الربح" Style="{StaticResource KpiKicker}"/>
                            <Border Style="{StaticResource KpiIcon}" Background="{StaticResource SecondaryLightBrush}">
                                <TextBlock Text="💰" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding Stats.CurrentPeriodNetProfit, StringFormat={}{0:N0}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource KpiNumber}">
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Stats.CurrentPeriodNetProfit, Converter={StaticResource LessThanZero}}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding NetProfitChangeText}" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCard}" Width="235">
                        <StackPanel>
                            <TextBlock Text="المستحق للموردين" Style="{StaticResource KpiKicker}"/>
                            <Border Style="{StaticResource KpiIcon}" Background="{StaticResource WarningLightBrush}">
                                <TextBlock Text="🏷️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding Stats.PayablesTotal, StringFormat={}{0:N0}}"
                                       Style="{StaticResource KpiNumber}" Foreground="{StaticResource SecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </StackPanel>

            <!-- ===== Recent Tickets ===== -->
            <Grid Margin="0,16,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="آخر التذاكر" Style="{StaticResource SectionTitle}" Margin="0"/>
                <Button Grid.Column="1" Content="عرض كل التذاكر ←" HorizontalAlignment="Left"
                        Style="{StaticResource GhostButton}" Padding="10,5" FontSize="13"
                        Click="ViewAllTickets_Click"/>
            </Grid>

            <Border Style="{StaticResource CardBorder}" Padding="0">
                <DataGrid x:Name="RecentTicketsGrid" ItemsSource="{Binding RecentTickets}"
                          Style="{StaticResource ModernDataGrid}" Cursor="Hand"
                          MouseDoubleClick="RecentTicketsGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="رقم التذكرة" Binding="{Binding TicketNumber}" Width="110"/>
                        <DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="130"/>
                        <DataGridTextColumn Header="الجهاز" Binding="{Binding DeviceInfo}" Width="140"/>
                        <DataGridTextColumn Header="المشكلة" Binding="{Binding ProblemDescription}" Width="*"/>
                        <DataGridTemplateColumn Header="الحالة" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StatusTag}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Background="{Binding Status, Converter={StaticResource TicketStatusBrush}, ConverterParameter=Background}">
                                        <TextBlock Text="{Binding Status, Converter={StaticResource TicketStatus}}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{Binding Status, Converter={StaticResource TicketStatusBrush}, ConverterParameter=Text}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="تاريخ الاستقبال" Binding="{Binding ReceiveDate, StringFormat={}{0:yyyy-MM-dd}}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <ProgressBar IsIndeterminate="True" Margin="0,12,0,0"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                         Style="{StaticResource ModernProgressBar}"/>
        </StackPanel>
    </ScrollViewer>
</Page>
