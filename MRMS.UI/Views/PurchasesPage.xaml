<Page x:Class="MRMS.UI.Views.PurchasesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="المشتريات" FlowDirection="RightToLeft"
      Style="{StaticResource PageBackground}">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="فواتير المشتريات" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="عرض وتسجيل فواتير شراء الأصناف من الموردين" Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}">
                    <Run Text="إجمالي الفواتير:"/>
                    <Run Text="{Binding Purchases.Count, Mode=OneWay, FallbackValue=0}" FontWeight="SemiBold"
                         Foreground="{StaticResource TextPrimaryBrush}"/>
                </TextBlock>

                <Button Grid.Column="1" Content="+ فاتورة مشتريات جديدة"
                        Style="{StaticResource PrimaryButton}"
                        Click="AddPurchase_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0" Effect="{StaticResource CardShadow}">
            <Grid>
                <DataGrid ItemsSource="{Binding Purchases}"
                          Style="{StaticResource ModernDataGrid}"
                          AutoGenerateColumns="False"
                          MouseDoubleClick="Purchases_MouseDoubleClick"
                          ToolTip="اضغط مرتين لعرض تفاصيل الفاتورة">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat={}{0:yyyy-MM-dd}}" Width="100"/>
                        <DataGridTextColumn Header="المورد" Binding="{Binding SupplierName}" Width="*"/>
                        <DataGridTextColumn Header="طريقة الدفع" Binding="{Binding PaymentMethod}" Width="100"/>
                        <DataGridTextColumn Header="المدفوع" Binding="{Binding PaidAmount, StringFormat={}{0:N0}}" Width="100"/>
                        <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalCost, StringFormat={}{0:N0}}" Width="100"/>
                        <DataGridTextColumn Header="الملاحظات" Binding="{Binding Notes}" Width="150"/>
                        <DataGridTemplateColumn Header="الإجراءات" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Button Content="إلغاء"
                                                Style="{StaticResource DangerActionButton}"
                                                Visibility="{Binding IsVoided, Converter={StaticResource InverseBoolToVis}}"
                                                Command="{Binding DataContext.VoidPurchaseCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding Id}"/>
                                        <Border Style="{StaticResource StatusTag}" Background="{StaticResource DangerLightBrush}"
                                                Visibility="{Binding IsVoided, Converter={StaticResource BoolToVis}}"
                                                ToolTip="{Binding VoidReason}">
                                            <TextBlock Text="ملغاة" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource DangerBrush}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <ProgressBar IsIndeterminate="True"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                             Height="3" VerticalAlignment="Top"
                             Style="{StaticResource ModernProgressBar}"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,12" VerticalAlignment="Bottom">
                    <Button Content="السابق" Style="{StaticResource SecondaryButton}"
                            Command="{Binding PreviousPageCommand}"
                            IsEnabled="{Binding HasPrevious}"
                            Padding="12,6"/>
                    <TextBlock Text="{Binding PageInfo}" VerticalAlignment="Center" Margin="16,0"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                    <Button Content="التالي" Style="{StaticResource SecondaryButton}"
                            Command="{Binding NextPageCommand}"
                            IsEnabled="{Binding HasNext}"
                            Padding="12,6"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
