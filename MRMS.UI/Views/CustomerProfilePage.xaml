<Page x:Class="MRMS.UI.Views.CustomerProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="ملف العميل" FlowDirection="RightToLeft"
      Style="{StaticResource PageBackground}">

    <ScrollViewer FlowDirection="LeftToRight">
        <StackPanel Margin="28" FlowDirection="RightToLeft">
            <!-- ===== Header ===== -->
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="ملف العميل" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="عرض معلومات العميل والأجهزة المرتبطة" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>

            <!-- ===== Profile Header Card ===== -->
            <Border Style="{StaticResource CardBorder}" Padding="24" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Avatar -->
                    <Border Grid.Column="0" Style="{StaticResource ProfileAvatar}"
                            VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding Customer.FullName, Converter={StaticResource FirstLetter}}"
                                   FontSize="32" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- Info -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Customer.FullName}"
                                   FontSize="22" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,6"/>
                        <TextBlock FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,4">
                            <Run Text="الهاتف:" FontWeight="SemiBold"/>
                            <Run Text="{Binding Customer.PhoneNumber}"/>
                        </TextBlock>
                        <TextBlock FontSize="13" Foreground="{StaticResource TextMutedBrush}">
                            <Run Text="مسجل منذ:"/>
                            <Run Text="{Binding Customer.CreatedAt, StringFormat={}{0:yyyy-MM-dd}}"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Quick Stats ===== -->
            <WrapPanel Margin="0,0,0,20">
                <Border Style="{StaticResource StatCardStyle}" Margin="0,0,12,8">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Devices.Count}" Style="{StaticResource StatValue}"
                                   Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock Text="الأجهزة المسجلة" Style="{StaticResource StatLabel}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCardStyle}" Margin="0,0,12,8">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedDeviceTickets.Count}" Style="{StaticResource StatValue}"
                                   Foreground="{StaticResource InfoBrush}"/>
                        <TextBlock Text="تذاكر الصيانة" Style="{StaticResource StatLabel}"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- ===== Devices Section ===== -->
            <TextBlock Text="الأجهزة" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>

            <Border Style="{StaticResource CardBorder}" Padding="0" Margin="0,0,0,28"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <DataGrid ItemsSource="{Binding Devices}"
                              Style="{StaticResource ModernDataGrid}"
                              SelectedItem="{Binding SelectedDevice}"
                              Cursor="Hand">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الماركة" Binding="{Binding Brand}" Width="*"/>
                            <DataGridTextColumn Header="الموديل" Binding="{Binding Model}" Width="*"/>
                            <DataGridTextColumn Header="IMEI" Binding="{Binding IMEI}" Width="160"/>
                            <DataGridTextColumn Header="اللون" Binding="{Binding Color}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ===== New Repair Ticket Section ===== -->
            <TextBlock Text="إنشاء تذكرة صيانة جديدة" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>

            <Border Style="{StaticResource CardBorder}" Padding="20" Margin="0,0,0,28"
                    Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <TextBlock Margin="0,0,0,14" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}">
                        <Run Text="لإنشاء تذكرة صيانة جديدة لجهاز موجود، اختر الجهاز من الجدول أعلاه أولاً، الجهاز المختار حالياً:"/>
                        <Run Text="{Binding SelectedDevice.Brand, FallbackValue='لم يتم اختيار جهاز', TargetNullValue='لم يتم اختيار جهاز'}" FontWeight="SemiBold"/>
                        <Run Text="{Binding SelectedDevice.Model}" FontWeight="SemiBold"/>
                    </TextBlock>

                    <StackPanel IsEnabled="{Binding HasSelectedDevice}">
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="وصف المشكلة" Style="{StaticResource FormLabel}"/>
                            <TextBox Text="{Binding NewTicketProblemDescription, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}" Height="60" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="ملاحظات الاستقبال" Style="{StaticResource FormLabel}"/>
                            <TextBox Text="{Binding NewTicketReceptionNotes, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}" Height="50" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button Content="إنشاء تذكرة صيانة جديدة لهذا الجهاز"
                                Command="{Binding CreateTicketForSelectedDeviceCommand}"
                                Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
                    </StackPanel>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               Margin="0,10,0,0" FontSize="13"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>

            <!-- ===== Repair History Section ===== -->
            <TextBlock Text="تاريخ الصيانة" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>

            <Border Style="{StaticResource CardBorder}" Padding="0" Margin="0,0,0,16"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <DataGrid x:Name="TicketsGrid" ItemsSource="{Binding SelectedDeviceTickets}"
                              Style="{StaticResource ModernDataGrid}"
                              Cursor="Hand"
                              MouseDoubleClick="TicketsGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم التذكرة" Binding="{Binding TicketNumber}" Width="110"/>
                            <DataGridTextColumn Header="المشكلة" Binding="{Binding ProblemDescription}" Width="*"/>
                            <DataGridTemplateColumn Header="الحالة" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatusTag}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Background="{Binding Status, Converter={StaticResource TicketStatusBrush}, ConverterParameter=Background}">
                                            <TextBlock Text="{Binding Status, Converter={StaticResource TicketStatus}}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{Binding Status, Converter={StaticResource TicketStatusBrush}, ConverterParameter=Text}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="تاريخ الاستقبال" Binding="{Binding ReceiveDate, StringFormat={}{0:yyyy-MM-dd}}" Width="120"/>
                            <DataGridTemplateColumn Header="الإجراءات" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="فتح" Style="{StaticResource ActionButton}"
                                                Command="{Binding DataContext.ViewTicketDetailCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding Id}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>


            <!-- ===== Loading ===== -->
            <ProgressBar IsIndeterminate="True"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                         Style="{StaticResource ModernProgressBar}"
                         Margin="0,4,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Page>
