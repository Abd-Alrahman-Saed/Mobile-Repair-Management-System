<Page x:Class="MRMS.UI.Views.DeviceRegistrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="استقبال جهاز" FlowDirection="RightToLeft">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="← رجوع" Command="{Binding ResetCommand}"
                        Padding="15,5" Background="#555" Foreground="White"
                        Visibility="{Binding ShowSearchImeiStep, Converter={StaticResource InverseBoolToVis}}"/>
                <TextBlock Grid.Column="1" Text="استقبال جهاز" FontSize="24"
                           FontWeight="Bold" HorizontalAlignment="Right"/>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="{Binding SuccessMessage}" Foreground="Green"
                       FontWeight="Bold" HorizontalAlignment="Center" FontSize="14"
                       Visibility="{Binding SuccessMessage, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red"
                       HorizontalAlignment="Center" FontSize="14"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}"/>
            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,5,0,0"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>

        <Border Grid.Row="2" BorderBrush="#CCC" BorderThickness="1"
                CornerRadius="5" Padding="15" Margin="0,5,0,0"
                Visibility="{Binding ShowSearchImeiStep, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="أدخل رقم IMEI للبحث" FontWeight="Bold" FontSize="16"
                           Margin="0,0,0,15"/>

                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="رقم IMEI" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Text="{Binding Imei, UpdateSourceTrigger=PropertyChanged}"
                                 Height="35" Width="280" FontSize="14" Padding="5"
                                 KeyDown="Imei_KeyDown"/>
                        <Button Content="بحث" Command="{Binding SearchImeiCommand}"
                                Margin="10,0,0,0" Padding="20,8"
                                Background="#0078D7" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,5,0,0"
                                 Visibility="{Binding IsSearchingImei, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" BorderBrush="#27AE60" BorderThickness="1"
                CornerRadius="5" Padding="15" Margin="0,5,0,0" Background="#E8F8F0"
                Visibility="{Binding ShowExistingDeviceStep, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="الجهاز مسجل مسبقاً - إنشاء تذكرة إصلاح" FontWeight="Bold" FontSize="16"
                           Foreground="#27AE60" Margin="0,0,0,15"/>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="العميل:" FontWeight="Bold"/>
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Text="{Binding FoundDeviceCustomer.FullName, FallbackValue='---'}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="الهاتف:" FontWeight="Bold"/>
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               Text="{Binding FoundDeviceCustomer.PhoneNumber, FallbackValue='---'}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="الجهاز:" FontWeight="Bold"/>
                    <TextBlock Grid.Row="2" Grid.Column="1">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} - {1} ({2})">
                                <Binding Path="FoundDevice.Brand"/>
                                <Binding Path="FoundDevice.Model"/>
                                <Binding Path="FoundDevice.Color"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="IMEI:" FontWeight="Bold"/>
                    <TextBlock Grid.Row="3" Grid.Column="1"
                               Text="{Binding FoundDevice.IMEI}"/>
                </Grid>

                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="وصف المشكلة *" Margin="0,0,0,5" FontWeight="Bold"/>
                    <TextBox Text="{Binding ProblemDescription}" Height="80" Width="450"
                             HorizontalAlignment="Right" FontSize="14" Padding="5"
                             AcceptsReturn="True" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="ملاحظات الاستقبال" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding ReceptionNotes}" Height="60" Width="450"
                             HorizontalAlignment="Right" FontSize="14" Padding="5"
                             AcceptsReturn="True" TextWrapping="Wrap"/>
                </StackPanel>

                <Button Content="إنشاء تذكرة الإصلاح"
                        Command="{Binding CreateTicketForExistingDeviceCommand}"
                        Padding="30,10" Background="#27AE60" Foreground="White"
                        FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" BorderBrush="#3498DB" BorderThickness="1"
                CornerRadius="5" Padding="15" Margin="0,5,0,0" Background="#EBF5FB"
                Visibility="{Binding ShowSearchCustomerStep, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="جهاز جديد - ابحث عن العميل" FontWeight="Bold" FontSize="16"
                           Foreground="#3498DB" Margin="0,0,0,15"/>

                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="اسم العميل" Margin="0,0,0,5" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Text="{Binding CustomerNameSearch, UpdateSourceTrigger=PropertyChanged}"
                                 Height="35" Width="280" FontSize="14" Padding="5"
                                 TextChanged="CustomerNameSearch_TextChanged"/>
                        <Button Content="بحث" Command="{Binding SearchCustomerCommand}"
                                Margin="10,0,0,0" Padding="20,8"
                                Background="#3498DB" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>

                <Border BorderBrush="#CCC" BorderThickness="1" CornerRadius="3" Margin="0,5,0,10"
                        Visibility="{Binding HasCustomerSearchResults, Converter={StaticResource BoolToVis}}"
                        MaxHeight="150">
                    <ListBox ItemsSource="{Binding CustomerSearchResults}"
                             SelectedItem="{Binding SelectedCustomerFromSearch}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="5">
                                    <TextBlock Text="{Binding FullName}" FontWeight="Bold" Margin="0,0,15,0"/>
                                    <TextBlock Text="{Binding PhoneNumber}" Foreground="#666"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="اختيار هذا العميل"
                            Command="{Binding UseSelectedCustomerCommand}"
                            Padding="20,8" Margin="0,0,10,0"
                            Background="#27AE60" Foreground="White" FontWeight="Bold"
                            IsEnabled="{Binding HasSelectedCustomerFromSearch}"/>
                    <Button Content="عميل جديد"
                            Command="{Binding SwitchToNewCustomerCommand}"
                            Padding="20,8"
                            Background="#E67E22" Foreground="White" FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" BorderBrush="#8E44AD" BorderThickness="1"
                CornerRadius="5" Padding="15" Margin="0,5,0,0" Background="#F5EEF8"
                Visibility="{Binding ShowNewDeviceAndTicketStep, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock FontWeight="Bold" FontSize="16" Foreground="#8E44AD" Margin="0,0,0,15">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNewCustomer}" Value="True">
                                    <Setter Property="Text" Value="عميل جديد + جهاز جديد + تذكرة"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsNewCustomer}" Value="False">
                                    <Setter Property="Text" Value="عميل موجود + جهاز جديد + تذكرة"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Border BorderBrush="#DDD" BorderThickness="0,0,0,1" Margin="0,0,0,15" Padding="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="بيانات العميل" FontWeight="Bold" FontSize="14"
                                   TextDecorations="Underline" Margin="0,0,0,10"/>

                        <StackPanel Visibility="{Binding IsNewCustomer, Converter={StaticResource BoolToVis}}">
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="اسم العميل *" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding NewCustomerName}" Height="35" Width="300"
                                         HorizontalAlignment="Right" FontSize="14" Padding="5"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="رقم الهاتف *" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding NewCustomerPhone}" Height="35" Width="300"
                                         HorizontalAlignment="Right" FontSize="14" Padding="5"/>
                            </StackPanel>
                        </StackPanel>

                        <Grid Visibility="{Binding IsNewCustomer, Converter={StaticResource InverseBoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="الاسم:" FontWeight="Bold"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedCustomerFinal.FullName}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="الهاتف:" FontWeight="Bold"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedCustomerFinal.PhoneNumber}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#DDD" BorderThickness="0,0,0,1" Margin="0,0,0,15" Padding="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="بيانات الجهاز" FontWeight="Bold" FontSize="14"
                                   TextDecorations="Underline" Margin="0,0,0,10"/>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="الماركة *" Margin="0,0,0,5"/>
                            <ComboBox Text="{Binding Brand, UpdateSourceTrigger=PropertyChanged}"
                                      ItemsSource="{Binding Brands}"
                                      IsEditable="True"
                                      Height="35" Width="300"
                                      HorizontalAlignment="Right" FontSize="14"
                                      IsTextSearchEnabled="True"
                                      StaysOpenOnEdit="True"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="الموديل" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding Model}" Height="35" Width="300"
                                     HorizontalAlignment="Right" FontSize="14" Padding="5"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,5">
                            <TextBlock Text="اللون" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding Color}" Height="35" Width="300"
                                     HorizontalAlignment="Right" FontSize="14" Padding="5"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="وصف المشكلة *" Margin="0,0,0,5" FontWeight="Bold"/>
                    <TextBox Text="{Binding ProblemDescription}" Height="80" Width="450"
                             HorizontalAlignment="Right" FontSize="14" Padding="5"
                             AcceptsReturn="True" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="ملاحظات الاستقبال" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding ReceptionNotes}" Height="60" Width="450"
                             HorizontalAlignment="Right" FontSize="14" Padding="5"
                             AcceptsReturn="True" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="رجوع" Command="{Binding BackToCustomerSearchCommand}"
                            Padding="20,8" Margin="0,0,10,0"
                            Background="#777" Foreground="White" FontWeight="Bold"/>
                    <Button Content="تسجيل وإنشاء التذكرة"
                            Command="{Binding RegisterNewDeviceAndTicketCommand}"
                            Padding="30,10"
                            Background="#8E44AD" Foreground="White" FontWeight="Bold" FontSize="14"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
