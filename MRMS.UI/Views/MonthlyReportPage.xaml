<Page x:Class="MRMS.UI.Views.MonthlyReportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      Title="التقرير الشهري" FlowDirection="RightToLeft"
      Style="{StaticResource PageBackground}">

    <ScrollViewer>
        <StackPanel Margin="28">

            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="التقرير الشهري" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="تحليل الأداء المالي الشهري مع الرسوم البيانية" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>

            <Border Style="{StaticResource CardBorder}" Padding="20" Margin="0,0,0,20"
                    Effect="{StaticResource CardShadow}">
                <WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center">
                        <TextBlock Text="السنة:" Style="{StaticResource FormLabel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding YearList}" SelectedItem="{Binding SelectedYear}"
                                  Width="100" Height="40" FontSize="15"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center">
                        <TextBlock Text="الشهر:" Style="{StaticResource FormLabel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding MonthList}" SelectedItem="{Binding SelectedMonth}"
                                  Width="100" Height="40" FontSize="15">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <Button Content="عرض" Command="{Binding LoadCommand}"
                            Style="{StaticResource PrimaryButton}" Padding="24,10"/>
                </WrapPanel>
            </Border>

            <!-- KPI Cards -->
            <WrapPanel Margin="0,0,0,24">
                <Border Style="{StaticResource StatCardStyle}" Width="220" Height="120" Margin="0,0,14,14"
                        Effect="{StaticResource CardShadow}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Report.CurrentMonthRevenue, StringFormat={}{0:N0}}"
                                   Style="{StaticResource StatValue}" Foreground="{StaticResource SuccessBrush}"/>
                        <TextBlock Text="الإيرادات" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding Report.RevenueChangePercent, StringFormat={}{0}%}"
                                   FontSize="12" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCardStyle}" Width="220" Height="120" Margin="0,0,14,14"
                        Effect="{StaticResource CardShadow}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Report.CurrentMonthExpenses, StringFormat={}{0:N0}}"
                                   Style="{StaticResource StatValue}" Foreground="{StaticResource DangerBrush}"/>
                        <TextBlock Text="المصروفات" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding Report.ExpensesChangePercent, StringFormat={}{0}%}"
                                   FontSize="12" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCardStyle}" Width="220" Height="120" Margin="0,0,14,14"
                        Effect="{StaticResource CardShadow}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Report.CurrentMonthNetProfit, StringFormat={}{0:N0}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource StatValue}">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Report.CurrentMonthNetProfit, Converter={StaticResource LessThanZero}}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="صافي الربح" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding Report.NetProfitChangePercent, StringFormat={}{0}%}"
                                   FontSize="12" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCardStyle}" Width="220" Height="120" Margin="0,0,14,14"
                        Effect="{StaticResource CardShadow}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Report.CurrentMonthCashBalance, StringFormat={}{0:N0}}"
                                   Style="{StaticResource StatValue}" Foreground="{StaticResource InfoBrush}"/>
                        <TextBlock Text="الرصيد النقدي" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding Report.CashBalanceChangePercent, StringFormat={}{0}%}"
                                   FontSize="12" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- 12-Month Table -->
            <TextBlock Text="جدول 12 شهر" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
            <Border Style="{StaticResource CardBorder}" Padding="0" Margin="0,0,0,24"
                    Effect="{StaticResource CardShadow}">
                <DataGrid ItemsSource="{Binding Report.Rows}" Style="{StaticResource ModernDataGrid}"
                          AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="400">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الشهر" Binding="{Binding MonthName}" Width="70"/>
                        <DataGridTextColumn Header="مبيعات" Binding="{Binding SalesRevenue, StringFormat={}{0:N0}}" Width="100"/>
                        <DataGridTextColumn Header="إصلاح" Binding="{Binding RepairRevenue, StringFormat={}{0:N0}}" Width="90"/>
                        <DataGridTextColumn Header="إيرادات" Binding="{Binding TotalRevenue, StringFormat={}{0:N0}}" Width="100"/>
                        <DataGridTextColumn Header="تكلفة م.مباعة" Binding="{Binding CostOfGoodsSold, StringFormat={}{0:N0}}" Width="100"/>
                        <DataGridTextColumn Header="تكلفة قطع" Binding="{Binding PartsCost, StringFormat={}{0:N0}}" Width="90"/>
                        <DataGridTextColumn Header="إجمالي الربح" Binding="{Binding GrossProfit, StringFormat={}{0:N0}}" Width="100"/>
                        <DataGridTextColumn Header="مصروفات" Binding="{Binding Expenses, StringFormat={}{0:N0}}" Width="90"/>
                        <DataGridTextColumn Header="صافي الربح" Binding="{Binding NetProfit, StringFormat={}{0:N0}}" Width="100"/>
                        <DataGridTextColumn Header="تدفق نقدي" Binding="{Binding NetCashFlow, StringFormat={}{0:N0}}" Width="100"/>
                        <DataGridTextColumn Header="رصيد نقدي تراكمي" Binding="{Binding CumulativeCashBalance, StringFormat={}{0:N0}}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Charts -->
            <TextBlock Text="الرسوم البيانية" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>

            <WrapPanel Margin="0,0,0,24">
                <Border Style="{StaticResource CardBorder}" Width="540" Height="360" Margin="0,0,14,14"
                        Effect="{StaticResource CardShadow}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="صافي الربح الشهري" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <lvc:CartesianChart Series="{Binding NetProfitSeries}"
                                            XAxes="{Binding XAxes}" YAxes="{Binding YAxes}"
                                            Height="280"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Width="540" Height="360" Margin="0,0,14,14"
                        Effect="{StaticResource CardShadow}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="الإيرادات مقابل المصروفات" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <lvc:CartesianChart Series="{Binding IncomeVsExpensesSeries}"
                                            XAxes="{Binding XAxes}" YAxes="{Binding YAxes}"
                                            Height="280"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Width="540" Height="360" Margin="0,0,14,14"
                        Effect="{StaticResource CardShadow}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="توزيع الإيرادات (مبيعات vs إصلاح)" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <lvc:CartesianChart Series="{Binding RevenueBreakdownSeries}"
                                            XAxes="{Binding XAxes}" YAxes="{Binding YAxes}"
                                            Height="280"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Width="540" Height="360" Margin="0,0,14,14"
                        Effect="{StaticResource CardShadow}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="أفضل 10 أصناف مبيعاً" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <lvc:CartesianChart Series="{Binding TopItemsSeries}"
                                            XAxes="{Binding TopItemsXAxes}" YAxes="{Binding TopItemsYAxes}"
                                            Height="280"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <ProgressBar IsIndeterminate="True"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                         Style="{StaticResource ModernProgressBar}"/>
        </StackPanel>
    </ScrollViewer>
</Page>
