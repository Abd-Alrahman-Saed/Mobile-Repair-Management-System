<Page x:Class="MRMS.UI.Views.JournalEntriesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="قيود اليومية" FlowDirection="RightToLeft"
      Style="{StaticResource PageBackground}">

    <ScrollViewer>
        <StackPanel Margin="28">

            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="قيود اليومية" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="السجلات المحاسبية لجميع المعاملات" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>

            <Border Style="{StaticResource CardBorder}" Padding="0" Margin="0,0,0,20"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <DataGrid x:Name="EntriesGrid" ItemsSource="{Binding Entries}"
                              Style="{StaticResource ModernDataGrid}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionChanged="EntriesGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat={}{0:yyyy-MM-dd}}" Width="100"/>
                            <DataGridTextColumn Header="الوصف" Binding="{Binding Description}" Width="200"/>
                            <DataGridTextColumn Header="المرجع" Binding="{Binding ReferenceType}" Width="120"/>
                            <DataGridTextColumn Header="رقم المرجع" Binding="{Binding ReferenceId}" Width="80"/>
                            <DataGridTemplateColumn Header="عدد الأسطر" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Lines.Count}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="تاريخ الإنشاء" Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <TextBlock Text="تفاصيل القيد" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
            <Border Style="{StaticResource CardBorder}" Padding="0" Margin="0,0,0,20"
                    Effect="{StaticResource CardShadow}">
                <DataGrid x:Name="LinesGrid" Style="{StaticResource ModernDataGrid}"
                          AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الحساب" Binding="{Binding AccountName}" Width="250"/>
                        <DataGridTextColumn Header="مدين" Binding="{Binding DebitAmount, StringFormat={}{0:N0}}" Width="150"/>
                        <DataGridTextColumn Header="دائن" Binding="{Binding CreditAmount, StringFormat={}{0:N0}}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <ProgressBar IsIndeterminate="True"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                         Style="{StaticResource ModernProgressBar}"/>
        </StackPanel>
    </ScrollViewer>
</Page>
