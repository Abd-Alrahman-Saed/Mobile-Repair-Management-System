<Page x:Class="MRMS.UI.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="الرئيسية" FlowDirection="RightToLeft">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#2D3E50">
            <StackPanel Margin="10">
                <TextBlock Text="KMG" FontSize="26" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center"
                           Margin="0,16,0,36"/>

                <Button Content="لوحة التحكم" Padding="14,12"
                        Background="Transparent" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        HorizontalContentAlignment="Right"
                        FontSize="15"
                        Click="Dashboard_Click"/>

                <Button Content="العملاء" Padding="14,12"
                        Background="Transparent" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        HorizontalContentAlignment="Right"
                        FontSize="15"
                        Click="Customers_Click"/>

                <Button Content="تسجيل جهاز" Padding="14,12"
                        Background="Transparent" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        HorizontalContentAlignment="Right"
                        FontSize="15"
                        Click="RegisterDevice_Click"/>

                <Button Content="تذاكر الإصلاح" Padding="14,12"
                        Background="Transparent" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        HorizontalContentAlignment="Right"
                        FontSize="15"
                        Click="RepairTickets_Click"/>

                <Button Content="نقل ملكية جهاز" Padding="14,12"
                        Background="Transparent" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        HorizontalContentAlignment="Right"
                        FontSize="15"
                        Click="TransferDevice_Click"/>

                <Button Content="بحث" Padding="14,12"
                        Background="Transparent" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        HorizontalContentAlignment="Right"
                        FontSize="15"
                        Click="Search_Click"/>

                <Button Content="تسجيل خروج" Padding="14,12"
                        Background="Transparent" Foreground="#E74C3C"
                        BorderThickness="0" Cursor="Hand"
                        HorizontalContentAlignment="Right"
                        FontSize="15"
                        VerticalAlignment="Bottom"
                        Margin="0,50,0,0"
                        Click="Logout_Click"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#F5F5F5" Padding="10,8"
                    BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="PageTitle"
                               FontSize="15" FontWeight="SemiBold" Foreground="#444"
                               VerticalAlignment="Center" Margin="5,0,0,0"/>
                    <Button Grid.Column="1" x:Name="BackButton"
                            Content="← رجوع" Padding="12,6"
                            Background="#2D3E50" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            FontSize="13" Click="Back_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Content="{TemplateBinding Content}"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <Frame x:Name="ContentFrame" Grid.Row="1"
                   NavigationUIVisibility="Hidden"
                   Navigated="ContentFrame_Navigated"/>

            <!-- ===== Notification Overlay (added in code-behind) ===== -->
            <Grid x:Name="NotificationLayer" Grid.Row="1"
                  Panel.ZIndex="1000" IsHitTestVisible="True"/>
        </Grid>
    </Grid>
</Page>
