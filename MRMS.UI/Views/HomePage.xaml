<Page x:Class="MRMS.UI.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="الرئيسية" FlowDirection="RightToLeft"
      KeyDown="Page_KeyDown">

    <Page.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style x:Key="NavSectionHeader" TargetType="TextBlock">
            <Setter Property="Text" Value=""/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource SidebarTextBrush}"/>
            <Setter Property="Margin" Value="14,18,14,4"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="KMG" FontSize="26" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center"
                                   Margin="0,16,0,20"/>

                        <Button Content="لوحة التحكم" Style="{StaticResource NavButton}"
                                Click="Dashboard_Click"/>

                        <!-- ===== العملاء والأجهزة ===== -->
                        <TextBlock Text="العملاء والأجهزة" Style="{StaticResource NavSectionHeader}"/>
                        <Button Content="العملاء" Style="{StaticResource NavButton}"
                                Click="Customers_Click"/>
                        <Button Content="تسجيل جهاز" Style="{StaticResource NavButton}"
                                Click="RegisterDevice_Click"/>
                        <Button Content="تذاكر الصيانة" Style="{StaticResource NavButton}"
                                Click="RepairTickets_Click"/>
                        <Button Content="نقل ملكية جهاز" Style="{StaticResource NavButton}"
                                Click="TransferDevice_Click"/>

                        <!-- ===== المخزون ===== -->
                        <TextBlock Text="المخزون" Style="{StaticResource NavSectionHeader}"/>
                        <Button Content="الأصناف" Style="{StaticResource NavButton}"
                                Click="Items_Click"/>
                        <Button Content="الحركات المخزنية" Style="{StaticResource NavButton}"
                                Click="StockMovements_Click"/>
                        <Button Content="كشف الرصيد المخزني" Style="{StaticResource NavButton}"
                                Click="StockBalance_Click"/>

                        <!-- ===== المبيعات والمشتريات ===== -->
                        <TextBlock Text="المبيعات والمشتريات" Style="{StaticResource NavSectionHeader}"/>
                        <Button Content="المبيعات" Style="{StaticResource NavButton}"
                                Click="Sales_Click"/>
                        <Button Content="المشتريات" Style="{StaticResource NavButton}"
                                Click="Purchases_Click"/>
                        <Button Content="الموردون" Style="{StaticResource NavButton}"
                                Click="Suppliers_Click"/>
                        <Button Content="دفعات الموردين" Style="{StaticResource NavButton}"
                                Click="SupplierPayments_Click"/>
                        <Button Content="المصروفات" Style="{StaticResource NavButton}"
                                Click="Expenses_Click"/>

                        <!-- ===== التقارير المالية ===== -->
                        <TextBlock Text="التقارير المالية" Style="{StaticResource NavSectionHeader}"/>
                        <Button Content="كشف حساب النقدية" Style="{StaticResource NavButton}"
                                Click="Cashbook_Click"/>
                        <Button Content="قائمة الدخل" Style="{StaticResource NavButton}"
                                Click="IncomeStatement_Click"/>
                        <Button Content="التقرير الشهري" Style="{StaticResource NavButton}"
                                Click="MonthlyReport_Click"/>

                        <!-- ===== النظام ===== -->
                        <TextBlock Text="النظام" Style="{StaticResource NavSectionHeader}"/>
                        <Button Content="بحث" Style="{StaticResource NavButton}"
                                Click="Search_Click"/>
                        <Button Content="الإعدادات" Style="{StaticResource NavButton}"
                                Click="Settings_Click"/>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="1" Margin="10,0,10,10">
                    <Rectangle Height="1" Fill="{StaticResource OnDarkSubtleBrush}" Margin="4,0,4,8"/>
                    <Button Content="تسجيل خروج" Style="{StaticResource NavButton}"
                            Foreground="{StaticResource DangerBrush}"
                            Click="Logout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource SurfaceMutedBrush}" Padding="10,8"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="PageTitle"
                               FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" Margin="5,0,0,0"/>
                    <Button Grid.Column="1" x:Name="BackButton"
                            Content="← رجوع" Padding="12,6"
                            Background="{StaticResource SidebarBrush}" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            FontSize="13" Click="Back_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Content="{TemplateBinding Content}"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <Frame x:Name="ContentFrame" Grid.Row="1"
                   NavigationUIVisibility="Hidden"
                   Navigated="ContentFrame_Navigated"/>

            <!-- ===== Notification Overlay (added in code-behind) ===== -->
            <Grid x:Name="NotificationLayer" Grid.Row="1"
                  Panel.ZIndex="1000" IsHitTestVisible="True"/>
        </Grid>
    </Grid>
</Page>
