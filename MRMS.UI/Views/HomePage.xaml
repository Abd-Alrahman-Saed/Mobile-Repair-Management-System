<Page x:Class="MRMS.UI.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="الرئيسية" FlowDirection="RightToLeft"
      KeyDown="Page_KeyDown">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="264"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar ===== -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="10" Direction="180" Opacity="0.35" Color="#0A1226"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,18,0,12">
                        <!-- Brand -->
                        <StackPanel Orientation="Horizontal" Margin="16,0,16,12">
                            <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource PrimaryBrush}">
                                <TextBlock Text="KMG" Foreground="White" FontWeight="Bold" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="مركز الصيانة" Foreground="White" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Text="نظام إدارة الأجهزة المحمولة" Foreground="{StaticResource SidebarTextBrush}" FontSize="10"/>
                            </StackPanel>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding NavGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Header}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource NavSectionHeader}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Header}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding Title}" Style="{StaticResource NavItemButton}"
                                                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                            CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- User card -->
                <Border Grid.Row="1" Background="{StaticResource OnDarkSubtleBrush}" CornerRadius="12"
                        Margin="10" Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="{StaticResource PrimaryBrush}">
                            <TextBlock Text="{Binding UserInitial}" Foreground="White" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserName}" Foreground="White" FontWeight="SemiBold" FontSize="13"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding UserRoleText}" Foreground="{StaticResource SidebarTextBrush}" FontSize="11"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="خروج" Style="{StaticResource NavItemButton}"
                                Padding="10,6" FontSize="12" Foreground="{StaticResource OnDarkDangerBrush}"
                                Command="{Binding LogoutCommand}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ===== Content area ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Topbar -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" Padding="16,10"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="← رجوع" Style="{StaticResource GhostButton}"
                            Padding="12,6" FontSize="13" Click="Back_Click"/>

                    <Grid Grid.Column="1" HorizontalAlignment="Center" Width="440" Margin="12,0">
                        <TextBox x:Name="SearchBox" Style="{StaticResource SearchTextBox}"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="🔍  بحث برقم تذكرة أو اسم عميل أو IMEI" IsHitTestVisible="False"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="13"
                                   VerticalAlignment="Center" Margin="16,0,0,0"
                                   Visibility="{Binding SearchQuery, Converter={StaticResource EmptyStringToVis}}"/>
                        <Popup x:Name="SearchResultsPopup" IsOpen="{Binding IsSearchOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=SearchBox}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Width="440"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,4,0,0">
                                <Border.Effect><StaticResource ResourceKey="ElevatedShadow"/></Border.Effect>
                                <ItemsControl ItemsSource="{Binding SearchResults}" Margin="6">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Click="SearchResult_Click" Style="{StaticResource GhostButton}"
                                                    HorizontalContentAlignment="Stretch" Padding="10,8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayText}" FontWeight="SemiBold" FontSize="13"
                                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding AdditionalInfo}" FontSize="11"
                                                               Foreground="{StaticResource TextMutedBrush}"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Popup>
                    </Grid>

                    <Grid Grid.Column="2">
                        <Button x:Name="BellButton" Content="🔔" Style="{StaticResource GhostButton}"
                                FontSize="16" Padding="10,6" Command="{Binding ToggleAlertsCommand}"/>
                        <Ellipse Width="8" Height="8" Fill="{StaticResource DangerBrush}"
                                 HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,6,0,0"
                                 Visibility="{Binding HasAlerts, Converter={StaticResource BoolToVis}}"/>
                        <Popup IsOpen="{Binding IsAlertsOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=BellButton}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="14" Width="320"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,4,0,0">
                                <Border.Effect><StaticResource ResourceKey="ElevatedShadow"/></Border.Effect>
                                <StackPanel Margin="8">
                                    <TextBlock Text="التنبيهات" FontWeight="SemiBold" FontSize="13" Margin="8,6"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="لا توجد تنبيهات جديدة" FontSize="12" Margin="8,10"
                                               Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"
                                               Visibility="{Binding HasAlerts, Converter={StaticResource InverseBoolToVis}}"/>
                                    <ItemsControl ItemsSource="{Binding Alerts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="8,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Top" Margin="0,5,0,0"
                                                             Fill="{Binding Severity, Converter={StaticResource AlertSeverity}}"/>
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Medium"
                                                                   Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                                                   Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </Grid>
            </Border>

            <Frame x:Name="ContentFrame" Grid.Row="1"
                   NavigationUIVisibility="Hidden"
                   Navigated="ContentFrame_Navigated"/>

            <Grid x:Name="NotificationLayer" Grid.Row="1"
                  Panel.ZIndex="1000" IsHitTestVisible="True"/>
        </Grid>
    </Grid>
</Page>
