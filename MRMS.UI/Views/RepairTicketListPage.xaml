<Page x:Class="MRMS.UI.Views.RepairTicketListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="تذاكر الإصلاح" FlowDirection="RightToLeft"
      Background="#F0F2F5">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="تذاكر الإصلاح" FontSize="22"
                   FontWeight="Bold" Margin="0,0,0,10" Foreground="#2C3E50"/>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding StatusGroups}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="4" MinWidth="210" MaxWidth="240"
                                BorderBrush="#D5D8DC" BorderThickness="1" CornerRadius="6"
                                Background="White">
                            <StackPanel>
                                <Border Background="{Binding HeaderBrush}" CornerRadius="6,6,0,0" Padding="10,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="Bold" FontSize="14" Foreground="White"/>
                                        <TextBlock Text="{Binding Count, StringFormat='عدد {0}'}"
                                                   FontSize="11" Foreground="#CCD1D9"/>
                                    </StackPanel>
                                </Border>

                                <ListView ItemsSource="{Binding Tickets}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          MaxHeight="580"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#EAECEE" BorderThickness="0,0,0,1" Padding="8,6">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding TicketNumber}"
                                                               FontWeight="Bold" FontSize="13" Foreground="#2C3E50"/>
                                                    <TextBlock Text="{Binding DeviceInfo}"
                                                               FontSize="12" Foreground="#7F8C8D"/>
                                                    <TextBlock Text="{Binding ProblemDescription}"
                                                               FontSize="11" Foreground="#95A5A6"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxHeight="28" Margin="0,2,0,2"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                            <Border Padding="4,1" CornerRadius="3"
                                                                    Background="{Binding DataContext.HeaderBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                                <TextBlock Text="{Binding Status, Converter={StaticResource TicketStatus}}"
                                                                           FontSize="10" Foreground="White"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding ReceiveDate, StringFormat='{}{0:yyyy-MM-dd}'}"
                                                                       FontSize="11" Foreground="#BDC3C7"
                                                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="فتح"
                                                                Padding="8,2" FontSize="11"
                                                                Background="#3498DB" Foreground="White"
                                                                BorderThickness="0" Cursor="Hand"
                                                                Command="{Binding DataContext.OpenTicketCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                CommandParameter="{Binding Id}"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <ProgressBar Grid.Row="1" IsIndeterminate="True"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                     Height="4" VerticalAlignment="Top"/>
    </Grid>
</Page>
