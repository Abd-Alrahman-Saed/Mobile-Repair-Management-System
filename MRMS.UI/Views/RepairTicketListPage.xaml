<Page x:Class="MRMS.UI.Views.RepairTicketListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="تذاكر الصيانة" FlowDirection="RightToLeft"
      Background="{StaticResource BackgroundBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="تذاكر الصيانة" FontSize="22"
                   FontWeight="Bold" Margin="0,0,0,10" Foreground="{StaticResource TextPrimaryBrush}"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="الفني:" VerticalAlignment="Center" Margin="0,0,8,0"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
            <ComboBox Width="180" Height="30" FontSize="13"
                      ItemsSource="{Binding TechnicianFilterOptions}"
                      DisplayMemberPath="Name" SelectedValuePath="Id"
                      SelectedValue="{Binding SelectedTechnicianFilterId}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding StatusGroups}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="4" MinWidth="210" MaxWidth="240"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                                Background="White">
                            <StackPanel>
                                <Border Background="{Binding HeaderBrush}" CornerRadius="6,6,0,0" Padding="10,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="Bold" FontSize="14" Foreground="White"/>
                                        <TextBlock Text="{Binding Count, StringFormat='عدد {0}'}"
                                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                </Border>

                                <ListView ItemsSource="{Binding Tickets}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          MaxHeight="580"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding TicketNumber}"
                                                               FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding DeviceInfo}"
                                                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding ProblemDescription}"
                                                               FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxHeight="28" Margin="0,2,0,2"/>
                                                    <TextBlock Text="{Binding AssignedTechnicianName, StringFormat='🔧 {0}'}"
                                                               FontSize="10" Foreground="{StaticResource PrimaryBrush}"
                                                               Visibility="{Binding AssignedTechnicianName, Converter={StaticResource NonEmptyStringToVis}}"
                                                               Margin="0,0,0,2"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                            <Border Padding="4,1" CornerRadius="3"
                                                                    Background="{Binding DataContext.HeaderBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                                <TextBlock Text="{Binding Status, Converter={StaticResource TicketStatus}}"
                                                                           FontSize="10" Foreground="White"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding ReceiveDate, StringFormat='{}{0:yyyy-MM-dd}'}"
                                                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="فتح"
                                                                Padding="8,2" FontSize="11"
                                                                Background="{StaticResource PrimaryBrush}" Foreground="White"
                                                                BorderThickness="0" Cursor="Hand"
                                                                Command="{Binding DataContext.OpenTicketCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                CommandParameter="{Binding Id}"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <ProgressBar Grid.Row="2" IsIndeterminate="True"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                     Height="4" VerticalAlignment="Top"/>
    </Grid>
</Page>
