<Page x:Class="MRMS.UI.Views.ItemFormPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:enums="clr-namespace:MRMS.Core.Enums;assembly=MRMS.Core"
      Title="بيانات الصنف" FlowDirection="RightToLeft"
      Style="{StaticResource PageBackground}">

    <ScrollViewer FlowDirection="LeftToRight">
        <StackPanel Margin="28" FlowDirection="RightToLeft">
            <StackPanel Margin="0,0,0,28">
                <TextBlock Text="بيانات الصنف" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="أدخل المعلومات الأساسية للصنف" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,24" Width="500" HorizontalAlignment="Center">
                <StackPanel>
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="كود الصنف (يمكن المسح مباشرة بجهاز QR / Barcode)" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="CodeBox" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBox}" KeyDown="CodeBox_KeyDown"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="اسم الصنف" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBox}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="النوع" Style="{StaticResource FormLabel}"/>
                        <ComboBox SelectedItem="{Binding SelectedType}"
                                  Style="{StaticResource FormTextBox}">
                            <ComboBox.Items>
                                <ComboBoxItem Content="إكسسوار" IsSelected="True"/>
                                <ComboBoxItem Content="قطعة غيار"/>
                            </ComboBox.Items>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="وحدة القياس" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBox}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="تكلفة الشراء" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding CostPrice, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBox}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="سعر البيع" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding SellingPrice, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBox}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,24">
                        <TextBlock Text="حد إعادة الطلب" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding ReorderLevel, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBox}"/>
                    </StackPanel>

                    <Border Background="{StaticResource DangerLightBrush}"
                            CornerRadius="8" Padding="12,10"
                            Margin="0,0,0,4"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource InverseBoolToVis}, FallbackValue=Collapsed}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{StaticResource DangerBrush}" FontSize="13"
                                   FontWeight="Medium"/>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderNoShadow}"
                    Background="{StaticResource DividerBrush}"
                    BorderThickness="0" Padding="16" Width="500" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="حفظ البيانات" Style="{StaticResource PrimaryButton}"
                            Command="{Binding SaveCommand}" Margin="0,0,12,0"/>
                    <Button Content="إلغاء" Style="{StaticResource SecondaryButton}"
                            Click="Cancel_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
