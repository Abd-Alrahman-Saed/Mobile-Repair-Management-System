<Window x:Class="MRMS.UI.Views.VoidReasonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إلغاء الحركة"
        Height="240" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="PromptText" Text="سبب الإلغاء" FontSize="15" FontWeight="SemiBold"
                   Margin="0,0,0,10"/>

        <TextBox Grid.Row="1" x:Name="ReasonBox" Height="70" TextWrapping="Wrap" AcceptsReturn="True"
                 FontSize="14" VerticalContentAlignment="Top"/>

        <TextBlock Grid.Row="2" x:Name="ErrorText" Foreground="{StaticResource DangerBrush}"
                   Margin="0,8,0,0" FontSize="12"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
            <Button Content="تأكيد الإلغاء" Style="{StaticResource DangerButton}" Padding="16,8" Click="Confirm_Click"/>
            <Button Content="تراجع" Style="{StaticResource SecondaryButton}" Padding="14,8" Margin="8,0,0,0" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
