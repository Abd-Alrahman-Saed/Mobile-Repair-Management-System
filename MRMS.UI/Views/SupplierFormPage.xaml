<Page x:Class="MRMS.UI.Views.SupplierFormPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="بيانات المورد" FlowDirection="RightToLeft"
      Style="{StaticResource PageBackground}">

    <ScrollViewer FlowDirection="LeftToRight">
        <StackPanel Margin="28" FlowDirection="RightToLeft">
            <StackPanel Margin="0,0,0,28">
                <TextBlock Text="بيانات المورد" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="أدخل المعلومات الأساسية للمورد" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16" Width="500" HorizontalAlignment="Center">
                <StackPanel>
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="كود المورد" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBox}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="اسم المورد" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBox}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="رقم الهاتف" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBox}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="الرصيد الافتتاحي" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding OpeningBalance, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBox}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,24">
                        <TextBlock Text="ملاحظات" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBox}" AcceptsReturn="True" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Background="{StaticResource DangerLightBrush}"
                            CornerRadius="8" Padding="12,10"
                            Margin="0,0,0,4"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource InverseBoolToVis}, FallbackValue=Collapsed}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{StaticResource DangerBrush}" FontSize="13"
                                   FontWeight="Medium"/>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderNoShadow}"
                    Background="{StaticResource DividerBrush}"
                    BorderThickness="0" Padding="16" Width="500" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="حفظ البيانات" Style="{StaticResource PrimaryButton}"
                            Command="{Binding SaveCommand}" Margin="0,0,12,0"/>
                    <Button Content="إلغاء" Style="{StaticResource SecondaryButton}"
                            Click="Cancel_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
