<Page x:Class="MRMS.UI.Views.PayablesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="المستحقات" FlowDirection="RightToLeft"
      Style="{StaticResource PageBackground}">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="المستحقات للموردين" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="عرض أرصدة الموردين والمبالغ المستحقة" Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock FontSize="13" Foreground="{StaticResource TextSecondaryBrush}">
                    <Run Text="إجمالي المستحقات:"/>
                    <Run Text="{Binding TotalOutstanding, StringFormat={}{0:N0}}" FontWeight="Bold"
                         Foreground="{StaticResource DangerBrush}"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0" Effect="{StaticResource CardShadow}">
            <Grid>
                <DataGrid ItemsSource="{Binding Suppliers}"
                          Style="{StaticResource ModernDataGrid}"
                          AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الكود" Binding="{Binding SupplierId}" Width="70"/>
                        <DataGridTextColumn Header="المورد" Binding="{Binding SupplierName}" Width="*"/>
                        <DataGridTextColumn Header="الرصيد الافتتاحي" Binding="{Binding OpeningBalance, StringFormat={}{0:N0}}" Width="110"/>
                        <DataGridTextColumn Header="إجمالي المشتريات" Binding="{Binding TotalPurchases, StringFormat={}{0:N0}}" Width="120"/>
                        <DataGridTextColumn Header="إجمالي المدفوعات" Binding="{Binding TotalPayments, StringFormat={}{0:N0}}" Width="120"/>
                        <DataGridTextColumn Header="المستحق" Binding="{Binding OutstandingBalance, StringFormat={}{0:N0}}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
                <ProgressBar IsIndeterminate="True"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                             Height="3" VerticalAlignment="Top"
                             Style="{StaticResource ModernProgressBar}"/>
            </Grid>
        </Border>
    </Grid>
</Page>
