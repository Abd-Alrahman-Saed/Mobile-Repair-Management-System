<Window x:Class="MRMS.UI.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MRMS - تسجيل الدخول"
        Icon="/Resources/AppIcon.ico"
        Height="310" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True"
        Visibility="Visible"
        ShowInTaskbar="True"
        FlowDirection="RightToLeft">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="نظام صيانة الأجهزة المحمولة"
                   FontSize="20" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="كلمة المرور" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PasswordBox" Height="30"
                         FontSize="14" Padding="5,0"
                         KeyDown="PasswordBox_KeyDown"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}"
                   Foreground="Red" HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>

        <Button Grid.Row="3" Content="دخول"
                Click="Login_Click"
                Height="35" FontSize="14"
                Background="{StaticResource PrimaryBrush}" Foreground="White"
                Cursor="Hand"/>

        <ProgressBar Grid.Row="4"
                     IsIndeterminate="True"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                     Height="5" Margin="0,15,0,0"/>
    </Grid>
</Window>
