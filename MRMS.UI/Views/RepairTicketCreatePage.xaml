<Page x:Class="MRMS.UI.Views.RepairTicketCreatePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="إنشاء تذكرة إصلاح" FlowDirection="RightToLeft">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="إنشاء تذكرة إصلاح" FontSize="24"
                   FontWeight="Bold" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="رقم IMEI للجهاز" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal">
                <TextBox Text="{Binding Imei, UpdateSourceTrigger=PropertyChanged}"
                         Height="30" Width="250" FontSize="14"/>
                <Button Content="بحث" Command="{Binding FindDeviceCommand}"
                        Margin="10,0,0,0" Padding="15,5"
                        Background="#0078D7" Foreground="White"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="2" BorderBrush="#27AE60" BorderThickness="1"
                CornerRadius="5" Padding="10" Margin="0,0,0,15"
                Visibility="{Binding DeviceFound, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock FontWeight="Bold" FontSize="14"
                           Text="{Binding FoundDevice.Brand, StringFormat='{}{0} '}"/>
                <TextBlock Text="{Binding FoundDevice.Model, StringFormat='موديل: {0}'}"/>
                <TextBlock Text="{Binding FoundDevice.IMEI, StringFormat='IMEI: {0}'}"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="وصف المشكلة" Margin="0,0,0,5"/>
            <TextBox Text="{Binding ProblemDescription}" Height="80" Width="400"
                     HorizontalAlignment="Right" FontSize="14"
                     AcceptsReturn="True" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,0,0,20">
            <TextBlock Text="ملاحظات الاستقبال" Margin="0,0,0,5"/>
            <TextBox Text="{Binding ReceptionNotes}" Height="60" Width="400"
                     HorizontalAlignment="Right" FontSize="14"
                     AcceptsReturn="True" TextWrapping="Wrap"/>
        </StackPanel>

        <TextBlock Grid.Row="5" Text="{Binding ErrorMessage}"
                   Foreground="Red" HorizontalAlignment="Center"/>

        <Button Grid.Row="6" Content="إنشاء التذكرة"
                Command="{Binding CreateTicketCommand}"
                Padding="20,8" Background="#0078D7" Foreground="White"
                Width="200" HorizontalAlignment="Center"/>

        <ProgressBar Grid.Row="7" IsIndeterminate="True"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                     Height="5"/>
    </Grid>
</Page>
