<Page x:Class="MRMS.UI.Views.CashbookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="كشف حساب النقدية" FlowDirection="RightToLeft"
      Style="{StaticResource PageBackground}">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="كشف حساب النقدية" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="عرض الحركات النقدية والرصيد الجاري" Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="من:" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <DatePicker Grid.Column="1" SelectedDate="{Binding FromDate, UpdateSourceTrigger=PropertyChanged}"
                            Width="140" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="2" Text="إلى:" VerticalAlignment="Center" Margin="16,0,8,0"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <DatePicker Grid.Column="3" SelectedDate="{Binding ToDate, UpdateSourceTrigger=PropertyChanged}"
                            Width="140" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="الرصيد الافتتاحي" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding OpeningBalance, StringFormat={}{0:N0}}" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="إجمالي الوارد" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding TotalInflows, StringFormat={}{0:N0}}" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource SuccessBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="إجمالي المنصرف" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding TotalOutflows, StringFormat={}{0:N0}}" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource DangerBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="الرصيد الختامي" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding ClosingBalance, StringFormat={}{0:N0}}" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="0" Effect="{StaticResource CardShadow}">
            <Grid>
                <DataGrid ItemsSource="{Binding Entries}"
                          Style="{StaticResource ModernDataGrid}"
                          AutoGenerateColumns="False"
                          CanUserSortColumns="False"
                          CanUserReorderColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat={}{0:yyyy-MM-dd}}" Width="90"/>
                        <DataGridTextColumn Header="البيان" Binding="{Binding Description}" Width="*"/>
                        <DataGridTextColumn Header="النوع" Binding="{Binding Type}" Width="70"/>
                        <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat={}{0:N0}}" Width="100"/>
                        <DataGridTextColumn Header="الرصيد الجاري" Binding="{Binding RunningBalance, StringFormat={}{0:N0}}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
                <ProgressBar IsIndeterminate="True"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                             Height="3" VerticalAlignment="Top"
                             Style="{StaticResource ModernProgressBar}"/>
            </Grid>
        </Border>
    </Grid>
</Page>
