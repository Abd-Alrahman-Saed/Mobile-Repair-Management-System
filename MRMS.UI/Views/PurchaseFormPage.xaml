<Page x:Class="MRMS.UI.Views.PurchaseFormPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vms="clr-namespace:MRMS.UI.ViewModels"
      Title="فاتورة مشتريات" FlowDirection="RightToLeft"
      Style="{StaticResource PageBackground}">

    <ScrollViewer>
        <StackPanel Margin="28">
            <StackPanel Margin="0,0,0,28">
                <TextBlock Text="فاتورة مشتريات جديدة" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="تسجيل فاتورة شراء من المورد مع الأصناف" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>

            <Border Style="{StaticResource CardBorder}" Padding="20" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,16">
                        <TextBlock Text="التاريخ" Style="{StaticResource FormLabel}"/>
                        <DatePicker SelectedDate="{Binding Date, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource FormTextBox}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,16">
                        <TextBlock Text="المورد" Style="{StaticResource FormLabel}"/>
                        <ComboBox ItemsSource="{Binding Suppliers}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedSupplierId, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource FormTextBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,16">
                        <TextBlock Text="طريقة الدفع" Style="{StaticResource FormLabel}"/>
                        <ComboBox SelectedItem="{Binding SelectedPaymentMethod}"
                                  Style="{StaticResource FormTextBox}">
                            <ComboBox.Items>
                                <ComboBoxItem Content="نقداً" IsSelected="True"/>
                                <ComboBoxItem Content="آجل"/>
                            </ComboBox.Items>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,16">
                        <TextBlock Text="المبلغ المدفوع" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,4">
                        <TextBlock Text="ملاحظات" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBox}" Height="60" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardBorder}" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="الأصناف" Style="{StaticResource SectionTitle}" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0" ItemsSource="{Binding Items}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedItemId}"
                                  Style="{StaticResource FormTextBox}"/>
                        <TextBox Grid.Column="1" Text="{Binding SelectedQuantity, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBox}" Margin="8,0,0,0"/>
                        <TextBox Grid.Column="2" Text="{Binding SelectedUnitCost, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBox}" Margin="8,0,0,0"/>
                        <Button Grid.Column="3" Content="إضافة" Style="{StaticResource PrimaryButton}"
                                Command="{Binding AddItemCommand}" Margin="8,0,0,0"/>
                    </Grid>

                    <DataGrid ItemsSource="{Binding PurchaseItems}"
                              Style="{StaticResource ModernDataGrid}"
                              AutoGenerateColumns="False" Height="200">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الصنف" Binding="{Binding ItemName}" Width="*"/>
                            <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity}" Width="80"/>
                            <DataGridTextColumn Header="سعر الوحدة" Binding="{Binding UnitCost, StringFormat={}{0:N0}}" Width="100"/>
                            <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalCost, StringFormat={}{0:N0}}" Width="100"/>
                            <DataGridTemplateColumn Header="حذف" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="×" Style="{StaticResource DangerActionButton}"
                                                Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock HorizontalAlignment="Left" Margin="0,8,0,0"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBrush}">
                        <Run Text="الإجمالي الكلي:"/>
                        <Run Text="{Binding TotalCost, StringFormat={}{0:N0}}"
                             FontWeight="Bold"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource DangerLightBrush}"
                    CornerRadius="8" Padding="12,10"
                    Margin="0,0,0,4"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource InverseBoolToVis}, FallbackValue=Collapsed}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource DangerBrush}" FontSize="13"
                           FontWeight="Medium"/>
            </Border>

            <Border Style="{StaticResource CardBorderNoShadow}"
                    Background="{StaticResource DividerBrush}"
                    BorderThickness="0" Padding="16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="حفظ الفاتورة" Style="{StaticResource PrimaryButton}"
                            Command="{Binding SaveCommand}" Margin="0,0,12,0"/>
                    <Button Content="إلغاء" Style="{StaticResource SecondaryButton}"
                            Command="{Binding CancelCommand}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
