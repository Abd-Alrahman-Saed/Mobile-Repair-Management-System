<Page x:Class="MRMS.UI.Views.CashRegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="درج النقدية" FlowDirection="RightToLeft"
      Style="{StaticResource PageBackground}">

    <ScrollViewer>
        <StackPanel Margin="28">

            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="درج النقدية" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="فتح الوردية وإقفال اليومية ومطابقة المعدود بالمتوقّع" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                       Margin="0,0,0,12" TextWrapping="Wrap"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NonEmptyStringToVis}}"/>

            <!-- No open session: open form -->
            <Border Style="{StaticResource CardBorder}" Padding="24" Margin="0,0,0,16"
                    Effect="{StaticResource CardShadow}"
                    Visibility="{Binding HasOpenSession, Converter={StaticResource InverseBoolToVis}}">
                <StackPanel>
                    <TextBlock Text="لا توجد وردية مفتوحة" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                    <TextBlock Text="أدخل الرصيد النقدي الموجود في الدرج الآن لبدء الوردية."
                               FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,14"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="الرصيد الافتتاحي:" Style="{StaticResource FormLabel}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Text="{Binding OpeningBalanceInput, UpdateSourceTrigger=PropertyChanged}"
                                 Width="160" Height="34" FontSize="14"/>
                        <Button Content="فتح الوردية" Command="{Binding OpenSessionCommand}"
                                Style="{StaticResource PrimaryButton}" Padding="20,8" Margin="12,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Open session: 4 cards + close form -->
            <StackPanel Visibility="{Binding HasOpenSession, Converter={StaticResource BoolToVis}}">
                <UniformGrid Rows="1" Margin="0,0,0,16">
                    <Border Style="{StaticResource CardBorder}" Padding="18" Margin="0,0,8,0" Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <TextBlock Text="الرصيد الافتتاحي" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding CurrentSession.OpeningBalance, StringFormat={}{0:N0}}"
                                       FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Padding="18" Margin="0,0,8,0" Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <TextBlock Text="المبيعات النقدية" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding CurrentSession.CashSales, StringFormat={}{0:N0}}"
                                       FontSize="20" FontWeight="Bold" Margin="0,4,0,0"
                                       Foreground="{StaticResource SuccessBrush}"/>
                            <TextBlock Text="{Binding CurrentSession.RepairCollections, StringFormat='+ تحصيل صيانة {0:N0}'}"
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Padding="18" Margin="0,0,8,0" Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <TextBlock Text="المصروفات النقدية" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding CurrentSession.CashExpenses, StringFormat={}{0:N0}}"
                                       FontSize="20" FontWeight="Bold" Margin="0,4,0,0"
                                       Foreground="{StaticResource DangerBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="{StaticResource RadiusMd}"
                            Padding="18" Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <TextBlock Text="المتوقّع في الدرج" FontSize="12" Foreground="{StaticResource PrimaryBrush}"/>
                            <TextBlock Text="{Binding ExpectedAmount, StringFormat={}{0:N0}}"
                                       FontSize="22" FontWeight="Bold" Margin="0,4,0,0"
                                       Foreground="{StaticResource PrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Style="{StaticResource CardBorder}" Padding="24" Margin="0,0,0,16" Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <TextBlock Text="إقفال اليومية" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding CurrentSession.OpenedByName, StringFormat='فُتحت بواسطة {0}'}"
                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,14"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="النقدية المعدودة:" Style="{StaticResource FormLabel}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Text="{Binding CountedAmountInput, UpdateSourceTrigger=PropertyChanged}"
                                     Width="160" Height="34" FontSize="14"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="الفرق:" Style="{StaticResource FormLabel}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Difference, StringFormat={}{0:N2}}" FontSize="16" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Difference}" Value="0">
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Difference, Converter={StaticResource LessThanZero}}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <TextBlock Text="ملاحظات" Style="{StaticResource FormLabel}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding CloseNotes}" Height="52" FontSize="13"
                                 AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,14"/>

                        <Button Content="إقفال اليومية" Command="{Binding CloseSessionCommand}"
                                Style="{StaticResource PrimaryButton}" Padding="24,10" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- History -->
            <Border Style="{StaticResource CardBorder}" Padding="20" Margin="0,0,0,16" Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <TextBlock Text="سجل الإقفالات" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                    <DataGrid ItemsSource="{Binding History}" AutoGenerateColumns="False"
                              IsReadOnly="True" HeadersVisibility="Column" MaxHeight="320"
                              Background="Transparent" BorderThickness="0" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="التاريخ" Width="*"
                                                Binding="{Binding BusinessDate, StringFormat={}{0:yyyy-MM-dd}}"/>
                            <DataGridTextColumn Header="الموظف" Width="*" Binding="{Binding OpenedByName}"/>
                            <DataGridTextColumn Header="الافتتاحي" Width="*"
                                                Binding="{Binding OpeningBalance, StringFormat={}{0:N0}}"/>
                            <DataGridTextColumn Header="المتوقّع" Width="*"
                                                Binding="{Binding ExpectedAmount, StringFormat={}{0:N0}}"/>
                            <DataGridTextColumn Header="المعدود" Width="*"
                                                Binding="{Binding CountedAmount, StringFormat={}{0:N0}}"/>
                            <DataGridTextColumn Header="الفرق" Width="*"
                                                Binding="{Binding Difference, StringFormat={}{0:N0}}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <ProgressBar IsIndeterminate="True"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                         Style="{StaticResource ModernProgressBar}"/>
        </StackPanel>
    </ScrollViewer>
</Page>
