<Page x:Class="MRMS.UI.Views.UserFormPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="بيانات المستخدم" FlowDirection="RightToLeft"
      Style="{StaticResource PageBackground}">

    <ScrollViewer FlowDirection="LeftToRight">
        <StackPanel Margin="28" FlowDirection="RightToLeft">
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="بيانات المستخدم" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="حساب دخول ودوره في النظام" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16" Width="500" HorizontalAlignment="Center">
                <StackPanel>
                    <StackPanel Margin="0,0,0,16" Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Text="اسم المستخدم" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBox}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="الاسم الكامل" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBox}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="الدور" Style="{StaticResource FormLabel}"/>
                        <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}"
                                  Height="40" FontSize="14">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource UserRole}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <CheckBox Content="نشط" IsChecked="{Binding IsActive}" Margin="0,0,0,16" FontSize="14"/>

                    <StackPanel Margin="0,0,0,16" Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Text="كلمة المرور المبدئية" Style="{StaticResource FormLabel}"/>
                        <PasswordBox x:Name="PasswordBox" Height="40" FontSize="14" Padding="8,0"/>
                        <TextBlock Text="سيُطلب من المستخدم تغييرها عند أول دخول" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"
                            Background="{StaticResource SurfaceMutedBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="إعادة تعيين كلمة المرور" Style="{StaticResource FormLabel}"/>
                            <StackPanel Orientation="Horizontal">
                                <PasswordBox x:Name="NewPasswordBox" Width="220" Height="36" FontSize="14" Padding="8,0"/>
                                <Button Content="إعادة تعيين" Style="{StaticResource SecondaryButton}"
                                        Padding="14,8" Margin="8,0,0,0" Click="ResetPassword_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               Margin="0,0,0,12" TextWrapping="Wrap"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="حفظ" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
                        <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                Command="{Binding CancelCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
