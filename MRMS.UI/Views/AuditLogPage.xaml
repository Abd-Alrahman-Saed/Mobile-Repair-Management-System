<Page x:Class="MRMS.UI.Views.AuditLogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="سجل التدقيق" FlowDirection="RightToLeft"
      Style="{StaticResource PageBackground}">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="سجل التدقيق" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="كل العمليات الحسّاسة باسم صاحبها" Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16">
            <WrapPanel>
                <StackPanel Margin="0,0,16,8">
                    <TextBlock Text="من تاريخ" Style="{StaticResource FormLabel}"/>
                    <DatePicker SelectedDate="{Binding FromDate}" Width="150"/>
                </StackPanel>
                <StackPanel Margin="0,0,16,8">
                    <TextBlock Text="إلى تاريخ" Style="{StaticResource FormLabel}"/>
                    <DatePicker SelectedDate="{Binding ToDate}" Width="150"/>
                </StackPanel>
                <StackPanel Margin="0,0,16,8">
                    <TextBlock Text="المستخدم" Style="{StaticResource FormLabel}"/>
                    <TextBox Text="{Binding UserFilter, UpdateSourceTrigger=PropertyChanged}" Width="160" Height="32"/>
                </StackPanel>
                <StackPanel Margin="0,0,16,8">
                    <TextBlock Text="نوع العملية" Style="{StaticResource FormLabel}"/>
                    <ComboBox ItemsSource="{Binding Actions}" SelectedItem="{Binding SelectedAction}" Width="180" Height="32"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
                    <Button Content="تطبيق" Style="{StaticResource PrimaryButton}" Padding="18,8"
                            Command="{Binding LoadCommand}"/>
                    <Button Content="مسح" Style="{StaticResource SecondaryButton}" Padding="14,8" Margin="8,0,0,0"
                            Command="{Binding ClearFiltersCommand}"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                   Margin="0,0,0,8" TextWrapping="Wrap"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}"/>

        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="0" Effect="{StaticResource CardShadow}">
            <Grid>
                <DataGrid ItemsSource="{Binding Entries}" Style="{StaticResource ModernDataGrid}"
                          AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الوقت" Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="150"/>
                        <DataGridTextColumn Header="المستخدم" Binding="{Binding UserName}" Width="140"/>
                        <DataGridTextColumn Header="العملية" Binding="{Binding Action}" Width="160"/>
                        <DataGridTextColumn Header="النوع" Binding="{Binding EntityType}" Width="120"/>
                        <DataGridTextColumn Header="التفاصيل" Binding="{Binding Details}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <ProgressBar IsIndeterminate="True"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                             Height="3" VerticalAlignment="Top"
                             Style="{StaticResource ModernProgressBar}"/>
            </Grid>
        </Border>
    </Grid>
</Page>
