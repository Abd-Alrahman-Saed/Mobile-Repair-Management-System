<Page x:Class="MRMS.UI.Views.ExpensesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="المصروفات" FlowDirection="RightToLeft"
      Style="{StaticResource PageBackground}">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="المصروفات" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="تسجيل وعرض المصروفات اليومية" Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock FontSize="13" Foreground="{StaticResource TextSecondaryBrush}">
                        <Run Text="عدد المصروفات:"/>
                        <Run Text="{Binding Expenses.Count, Mode=OneWay, FallbackValue=0}" FontWeight="SemiBold"
                             Foreground="{StaticResource TextPrimaryBrush}"/>
                    </TextBlock>
                    <TextBlock FontSize="15" Margin="0,4,0,0">
                        <Run Text="الإجمالي:" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Run Text="{Binding FilteredTotal, Mode=OneWay, StringFormat={}{0:N0}, FallbackValue=0}"
                             FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                    </TextBlock>
                </StackPanel>

                <Button Grid.Column="1" Content="+ مصروف جديد"
                        Style="{StaticResource PrimaryButton}"
                        Click="AddExpense_Click"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,16">
            <Button x:Name="AllPeriodButton" Content="الكل" Style="{StaticResource SecondaryButton}"
                    Padding="14,7" Margin="0,0,8,0" Click="PeriodAll_Click"/>
            <Button x:Name="ThisMonthButton" Content="هذا الشهر" Style="{StaticResource SecondaryButton}"
                    Padding="14,7" Margin="0,0,8,0" Click="PeriodThisMonth_Click"/>
            <Button x:Name="LastMonthButton" Content="الشهر الماضي" Style="{StaticResource SecondaryButton}"
                    Padding="14,7" Click="PeriodLastMonth_Click"/>
        </StackPanel>

        <TextBox Grid.Row="3" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource SearchTextBox}"
                 Margin="0,0,0,16"/>

        <Border Grid.Row="4" Style="{StaticResource CardBorder}" Padding="0" Effect="{StaticResource CardShadow}">
            <Grid>
                <DataGrid ItemsSource="{Binding Expenses}"
                          Style="{StaticResource ModernDataGrid}"
                          AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat={}{0:yyyy-MM-dd}}" Width="90"/>
                        <DataGridTextColumn Header="التصنيف" Binding="{Binding Category}" Width="100"/>
                        <DataGridTextColumn Header="الوصف" Binding="{Binding Description}" Width="*"/>
                        <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat={}{0:N0}}" Width="100"/>
                        <DataGridTextColumn Header="طريقة الدفع" Binding="{Binding PaymentMethod}" Width="90"/>
                        <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="120"/>
                        <DataGridTemplateColumn Header="الإجراءات" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="حذف"
                                            Style="{StaticResource DangerActionButton}"
                                            Command="{Binding DataContext.DeleteExpenseCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding Id}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <ProgressBar IsIndeterminate="True"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                             Height="3" VerticalAlignment="Top"
                             Style="{StaticResource ModernProgressBar}"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,12" VerticalAlignment="Bottom">
                    <Button Content="السابق" Style="{StaticResource SecondaryButton}"
                            Command="{Binding PreviousPageCommand}"
                            IsEnabled="{Binding HasPrevious}"
                            Padding="12,6"/>
                    <TextBlock Text="{Binding PageInfo}" VerticalAlignment="Center" Margin="16,0"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                    <Button Content="التالي" Style="{StaticResource SecondaryButton}"
                            Command="{Binding NextPageCommand}"
                            IsEnabled="{Binding HasNext}"
                            Padding="12,6"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
