<Application x:Class="MRMS.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MRMS.UI.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/ModernStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
            <converters:NotConverter x:Key="Not"/>
            <converters:TicketStatusConverter x:Key="TicketStatus"/>
            <converters:TicketStatusBrushConverter x:Key="TicketStatusBrush"/>
            <converters:FirstLetterConverter x:Key="FirstLetter"/>
            <converters:InverseSignConverter x:Key="InverseSign"/>
            <converters:LessThanZeroConverter x:Key="LessThanZero"/>
            <converters:FileSizeConverter x:Key="FileSize"/>
            <converters:BoolToResultTextConverter x:Key="BoolToResultText"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
